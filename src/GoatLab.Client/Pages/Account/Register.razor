@page "/register"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout GoatLab.Client.Layout.AuthLayout
@using GoatLab.Shared.DTOs
@inject AuthService AuthApi
@inject CookieAuthStateProvider AuthState
@inject NavigationManager Nav
@inject HttpClient Http

<PageTitle>Sign up — GoatLab</PageTitle>

<MudPaper Elevation="4" Class="pa-8" Style="max-width: 480px; margin: 4rem auto;">
    @if (_pendingConfirmEmail is not null)
    {
        <div class="text-center">
            <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h5" Class="mt-2 mb-2">Check your inbox</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                We sent a confirmation link to <strong>@_pendingConfirmEmail</strong>.
                Click it to finish setting up your account, then sign in.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth Href="@LoginHref">
                Go to sign in
            </MudButton>
        </div>
    }
    else
    {
        @if (_invite is not null)
        {
            <div class="d-flex align-center mb-3" style="gap:10px;">
                <MudIcon Icon="@Icons.Material.Filled.GroupAdd" Color="Color.Primary" Size="Size.Large" />
                <div>
                    <MudText Typo="Typo.h5">Join @_invite.FarmName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        You've been invited as a <strong>@_invite.Role.ToString().ToLowerInvariant()</strong>.
                        Create your account to join.
                    </MudText>
                </div>
            </div>
        }
        else
        {
            <MudText Typo="Typo.h5" GutterBottom="true">Start your free GoatLab account</MudText>
            <MudText Typo="Typo.body2" Class="mb-4" Color="Color.Secondary">
                Track your herd, milk production, breeding, health — everything in one place.
            </MudText>
        }

        <EditForm Model="@_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />
            @if (_invite is null)
            {
                <MudTextField @bind-Value="_model.FarmName" Label="Farm / homestead name" Variant="Variant.Outlined"
                              Required="true" Class="mb-3" HelperText="You can rename this later." />
            }
            <MudTextField @bind-Value="_model.DisplayName" Label="Your name" Variant="Variant.Outlined"
                          Required="true" Class="mb-3" />
            <MudTextField @bind-Value="_model.Email" Label="Email" Variant="Variant.Outlined"
                          InputType="InputType.Email" Required="true" Class="mb-3"
                          ReadOnly="@(_invite is not null)"
                          HelperText="@(_invite is not null ? "Locked to the invited address." : null)" />
            <MudTextField @bind-Value="_model.Password" Label="Password" Variant="Variant.Outlined"
                          InputType="InputType.Password" Required="true" Class="mb-4"
                          HelperText="At least 8 characters with upper, lower, digit, and symbol." />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                       Color="Color.Primary" FullWidth="true" Disabled="_busy">
                @(_busy
                    ? (_invite is not null ? "Joining farm…" : "Creating account…")
                    : (_invite is not null ? $"Join {_invite.FarmName}" : "Create account"))
            </MudButton>
        </EditForm>

        <MudText Typo="Typo.body2" Class="mt-4" Align="Align.Center">
            Already have an account? <MudLink Href="@LoginHref">Sign in</MudLink>
        </MudText>
    }
</MudPaper>

@code {
    private RegisterModel _model = new();
    private string? _error;
    private bool _busy;
    private string? _pendingConfirmEmail;
    private string? _returnUrl;
    private string? _inviteToken;
    private InvitePreview? _invite;

    // Mirrors TeamController.InvitePreviewDto on the server. We deserialize
    // into this lightweight shape rather than pulling the whole shared DTO
    // module in just for a registration page.
    public record InvitePreview(string Email, string FarmName, GoatLab.Shared.Models.TenantRole Role, DateTime ExpiresAt);

    // Route preservation: /register?returnUrl=/transfer/XXX lets us hand the
    // user back to the page they came from after they finish signing up.
    // Only in-app relative paths are honored to prevent open-redirect abuse.
    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);
        var qs = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var candidate = qs["returnUrl"];
        if (!string.IsNullOrWhiteSpace(candidate) && candidate.StartsWith('/') && !candidate.StartsWith("//"))
        {
            _returnUrl = candidate;
        }

        // Invite-aware register: fetch the invite preview so we can hide the
        // farm-name field, lock the email to the invited address, and route
        // through the invite-on-register server path.
        _inviteToken = qs["inviteToken"];
        if (!string.IsNullOrWhiteSpace(_inviteToken))
        {
            try
            {
                _invite = await Http.GetFromJsonAsync<InvitePreview>(
                    $"api/team/invites/preview?token={Uri.EscapeDataString(_inviteToken)}");
                if (_invite is not null)
                {
                    _model.Email = _invite.Email;
                    // FarmName isn't asked for in the invite flow — use a
                    // placeholder so server-side validation passes even though
                    // the field is ignored when InviteToken is set.
                    _model.FarmName = _invite.FarmName;
                }
            }
            catch
            {
                // Token invalid / expired — fall through to standard register
                // and let the user pick. Better than a hard error: maybe the
                // token expired but they still want to make an account.
                _invite = null;
                _inviteToken = null;
            }
        }
    }

    private string LoginHref => string.IsNullOrEmpty(_returnUrl)
        ? "/login"
        : $"/login?returnUrl={Uri.EscapeDataString(_returnUrl)}";

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var result = await AuthApi.RegisterAsync(new RegisterRequest(
            _model.Email, _model.Password, _model.DisplayName, _model.FarmName, _inviteToken));
        _busy = false;

        if (!result.Ok)
        {
            _error = result.Error?.Length > 200 ? "Couldn't create account. Please check your details." : (result.Error ?? "Registration failed.");
            return;
        }

        if (result.RequiresConfirmation)
        {
            _pendingConfirmEmail = result.Email ?? _model.Email;
            return;
        }

        AuthState.NotifyUserChanged(result.User);
        // On invite acceptance, route to the dashboard of the joined tenant
        // rather than honoring an upstream returnUrl that pointed back at
        // /accept-invite (would be a no-op now that they're already a member).
        Nav.NavigateTo(_invite is not null ? "/dashboard" : (_returnUrl ?? "/dashboard"));
    }

    private class RegisterModel
    {
        public string FarmName { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
