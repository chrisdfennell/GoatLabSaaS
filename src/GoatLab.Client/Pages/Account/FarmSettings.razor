@page "/farm-settings"
@using GoatLab.Shared.Models
@inject TenantSettingsService SettingsApi
@inject CookieAuthStateProvider AuthState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Farm settings — GoatLab</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-6">
    <MudText Typo="Typo.h4" GutterBottom="true">Farm settings</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Update your farm's display name, location, and unit system. Only farm owners can make changes.
    </MudText>

    @if (_settings is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudPaper Class="pa-6">
            <MudTextField @bind-Value="_name" Label="Farm name" Required="true"
                          HelperText="How the farm appears in the app and on emails." Class="mb-3" />

            <MudTextField Value="_settings.Slug" Label="URL slug" ReadOnly="true"
                          HelperText="Immutable. Used in URLs and Stripe customer records." Class="mb-3" />

            <MudTextField @bind-Value="_location" Label="Location"
                          HelperText="City, state or any description — shown on reports." Class="mb-3" />

            <MudSelect T="TenantUnits" @bind-Value="_units" Label="Units" Class="mb-4">
                <MudSelectItem Value="TenantUnits.Imperial">Imperial (lb, ft, °F)</MudSelectItem>
                <MudSelectItem Value="TenantUnits.Metric">Metric (kg, m, °C)</MudSelectItem>
            </MudSelect>

            <MudSwitch T="bool" @bind-Value="_alertEmailEnabled" Color="Color.Primary" Class="mb-4"
                       Label="Email me a daily summary of new alerts"
                       UncheckedColor="Color.Default" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block">
                Sent at 07:00 UTC to the farm owner. Only fires when there are new alerts in the last 24 hours.
            </MudText>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.h6" Class="mb-2">Public farm page</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                When on, anyone with the link can see goats you've marked "for sale".
                URL: <MudLink Href="@PublicFarmUrl" Target="_blank">@PublicFarmUrl</MudLink>
            </MudText>
            <MudSwitch T="bool" @bind-Value="_publicProfileEnabled" Color="Color.Primary" Class="mb-3"
                       Label="Enable public farm page"
                       UncheckedColor="Color.Default" />
            <MudTextField @bind-Value="_publicContactEmail" Label="Public contact email"
                          HelperText="Shown on the public page so buyers can reach you. Defaults to nothing — leave blank to hide."
                          Class="mb-4" />

            @if (_canStripeDeposits)
            {
                <MudNumericField @bind-Value="_publicDepositPercent" Label="Online deposit percent" Min="0" Max="100" Step="5"
                                 HelperText="Set above 0 to show a 'Reserve with deposit' button on each listing. Collects that percent of the asking price via Stripe. 0 disables the flow (contact button only)."
                                 Adornment="Adornment.End" AdornmentText="%" Class="mb-4"
                                 Disabled="@(!_publicProfileEnabled)" />
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.Lock">
                    <strong>Online deposit reservations</strong> are part of the Farm and Dairy plans.
                    <MudLink Href="/billing">Upgrade</MudLink> to collect Stripe deposits on your listings.
                </MudAlert>
            }

            @if (_canMapPin)
            {
                <MudText Typo="Typo.subtitle2" Class="mb-1">Map pin (optional)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                    Drop a pin so your farm shows up on the marketplace map view. Right-click your barn in
                    <MudLink Href="https://www.google.com/maps" Target="_blank">Google Maps</MudLink>
                    and click the lat/lng to copy, then paste below. Leave blank to stay off the map.
                </MudText>
                <MudGrid Class="mb-3">
                    <MudItem xs="6">
                        <MudNumericField T="double?" @bind-Value="_publicLatitude" Label="Latitude" Min="-90" Max="90" Step="0.0001"
                                         HelperText="-90 to 90" Disabled="@(!_publicProfileEnabled)" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField T="double?" @bind-Value="_publicLongitude" Label="Longitude" Min="-180" Max="180" Step="0.0001"
                                         HelperText="-180 to 180" Disabled="@(!_publicProfileEnabled)" />
                    </MudItem>
                </MudGrid>
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" Icon="@Icons.Material.Filled.Lock">
                    <strong>Marketplace map pin</strong> is part of the Farm and Dairy plans.
                    <MudLink Href="/billing">Upgrade</MudLink> to put your farm on the public map.
                </MudAlert>
            }

            @if (_publicProfileEnabled)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.h6" Class="mb-2">Embed on your own website</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Paste either of these snippets into your existing website to drive buyers to your
                    GoatLab listings. Auto-updates whenever you list or unlist a goat.
                </MudText>

                <MudText Typo="Typo.subtitle2" Class="mb-1">"Available on GoatLab" badge</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                    Small clickable button that shows your current listing count.
                </MudText>
                <MudTextField Value="@BadgeSnippet" ReadOnly Variant="Variant.Outlined" Lines="2"
                              Class="mb-2" Style="font-family:ui-monospace,monospace;font-size:13px;" />

                <MudText Typo="Typo.subtitle2" Class="mb-1 mt-3">Live listings grid (iframe)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                    Embeds up to 6 of your current listings. Goes anywhere a paragraph of HTML fits.
                </MudText>
                <MudTextField Value="@IframeSnippet" ReadOnly Variant="Variant.Outlined" Lines="3"
                              Class="mb-2" Style="font-family:ui-monospace,monospace;font-size:13px;" />
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }

            <div class="d-flex">
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="SaveAsync" Disabled="_busy || !HasChanges">
                    @(_busy ? "Saving…" : "Save")
                </MudButton>
            </div>

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4 d-block">
                Farm created @_settings.CreatedAt.ToLocalTime().ToString("MMM d, yyyy").
            </MudText>
        </MudPaper>
    }
</MudContainer>

@code {
    private TenantSettingsService.Settings? _settings;
    private string _name = "";
    private string? _location;
    private TenantUnits _units;
    private bool _alertEmailEnabled;
    private bool _publicProfileEnabled;
    private string? _publicContactEmail;
    private int _publicDepositPercent;
    private double? _publicLatitude;
    private double? _publicLongitude;
    private bool _canMapPin;
    private bool _canStripeDeposits;
    private string? _error;
    private bool _busy;

    private string PublicFarmUrl => _settings is null
        ? ""
        : $"{Nav.BaseUri.TrimEnd('/')}/pub/{_settings.Slug}";

    private string BadgeSnippet
    {
        get
        {
            if (_settings is null) return "";
            var origin = Nav.BaseUri.TrimEnd('/');
            return $"<a href=\"{origin}/pub/{_settings.Slug}\" target=\"_blank\">" +
                   $"<img src=\"{origin}/embed/badge/{_settings.Slug}.svg\" alt=\"Available on GoatLab\" width=\"220\" height=\"56\" />" +
                   $"</a>";
        }
    }

    private string IframeSnippet
    {
        get
        {
            if (_settings is null) return "";
            var origin = Nav.BaseUri.TrimEnd('/');
            return $"<iframe src=\"{origin}/embed/listings/{_settings.Slug}\" " +
                   "style=\"width:100%;min-height:520px;border:0;\" " +
                   "loading=\"lazy\" title=\"Goats for sale on GoatLab\"></iframe>";
        }
    }

    private bool HasChanges =>
        _settings is not null &&
        (_name != _settings.Name
         || (_location ?? "") != (_settings.Location ?? "")
         || _units != _settings.Units
         || _alertEmailEnabled != _settings.AlertEmailEnabled
         || _publicProfileEnabled != _settings.PublicProfileEnabled
         || (_publicContactEmail ?? "") != (_settings.PublicContactEmail ?? "")
         || _publicDepositPercent != _settings.PublicDepositPercent
         || _publicLatitude != _settings.PublicLatitude
         || _publicLongitude != _settings.PublicLongitude);

    protected override async Task OnInitializedAsync()
    {
        // Feature flags come from the auth state's EnabledFeatures list,
        // already populated by /api/account/me from the current tenant's plan.
        _ = await AuthState.GetAuthenticationStateAsync();
        var features = AuthState.CurrentUser?.EnabledFeatures;
        _canMapPin = features?.Contains("MarketplaceMapPin") ?? false;
        _canStripeDeposits = features?.Contains("StripeDeposits") ?? false;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _settings = await SettingsApi.GetAsync();
        if (_settings is null) return;
        _name = _settings.Name;
        _location = _settings.Location;
        _units = _settings.Units;
        _alertEmailEnabled = _settings.AlertEmailEnabled;
        _publicProfileEnabled = _settings.PublicProfileEnabled;
        _publicContactEmail = _settings.PublicContactEmail;
        _publicDepositPercent = _settings.PublicDepositPercent;
        _publicLatitude = _settings.PublicLatitude;
        _publicLongitude = _settings.PublicLongitude;
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var (ok, err, updated) = await SettingsApi.UpdateAsync(new TenantSettingsService.UpdateInput(_name.Trim(), _location?.Trim(), _units, _alertEmailEnabled, _publicProfileEnabled, _publicContactEmail?.Trim(), _publicDepositPercent, _publicLatitude, _publicLongitude));
            if (!ok)
            {
                _error = err?.Length > 200 ? "Couldn't save. Check your inputs." : (err ?? "Save failed.");
                return;
            }
            _settings = updated;
            Snackbar.Add("Farm settings saved.", Severity.Success);
        }
        finally { _busy = false; }
    }
}
