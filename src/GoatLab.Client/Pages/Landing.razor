    .plan {
        background:#fff; padding:32px; border-radius:20px;
        border:1px solid rgba(0,0,0,0.08); position:relative;
        display:flex; flex-direction:column;
    }
    .plan.featured {
        border-color:#2e7d32; box-shadow: 0 20px 40px -15px rgba(46,125,50,0.3);
        transform: translateY(-6px);
    }
    @@media (max-width: 900px) { .plan.featured { transform:none; } }
    .plan-badge {
        position:absolute; top:-12px; left:50%; transform:translateX(-50%);
        background:#2e7d32; color:#fff; font-size:12px; font-weight:700;
        padding:5px 12px; border-radius:999px; letter-spacing:0.5px;
    }
    .plan-name { font-size:14px; font-weight:700; text-transform:uppercase; color:#2e7d32; letter-spacing:1px; }
    .plan-price {
        font-size:44px; font-weight:800; letter-spacing:-1.5px;
        margin:8px 0 4px; color:#102a1a;
    }
    .plan-price span { font-size:15px; font-weight:500; color:#6b7a70; margin-left:6px; letter-spacing:0; }
    .plan-line { color:#3a4a3e; font-size:14px; margin-bottom:20px; }
    .plan ul { list-style:none; padding:0; margin:0 0 24px; flex:1; }
    .plan ul li {
        display:flex; align-items:center; gap:10px;
        padding:8px 0; font-size:14.5px; color:#1a2e1f;
    }
    .plan ul li .mud-icon-root { color:#2e7d32; font-size:18px !important; }

    /* Self-host / Docker */
    .self-host {
        padding:100px 0; background:#0f1f13; color:#e8f0ea;
        border-top:1px solid rgba(255,255,255,0.06);
    }
    .self-host h2 { color:#fff; font-size:40px; line-height:1.1; font-weight:800; letter-spacing:-1px; margin:12px 0 16px; }
    .self-host p { color:rgba(255,255,255,0.82); font-size:16px; line-height:1.6; margin:0 0 20px; max-width:560px; }
    .self-host .eyebrow { background:rgba(102,187,106,0.18); color:#a5d6a7; }
    .self-host code {
        background:rgba(255,255,255,0.08); padding:2px 6px; border-radius:6px;
        font-family: ui-monospace, Menlo, monospace; font-size:0.92em;
    }
    .self-host-inner {
        display:grid; grid-template-columns: 1fr 1.05fr; gap:56px; align-items:center;
    }
    @@media (max-width: 960px) { .self-host-inner { grid-template-columns: 1fr; gap:40px; } }
    @@media (max-width: 720px) { .self-host h2 { font-size:30px; } }
    .self-host-list { list-style:none; padding:0; margin:0 0 28px; }
    .self-host-list li {
        display:flex; align-items:center; gap:10px;
        padding:6px 0; font-size:15px; color:#dbe7de;
    }
    .self-host-list li .mud-icon-root { color:#66bb6a; font-size:18px !important; }
    .self-host-ctas { display:flex; gap:12px; flex-wrap:wrap; }

    .self-host-terminal {
        background:#0a1510; border-radius:14px; overflow:hidden;
        border:1px solid rgba(255,255,255,0.08);
        box-shadow: 0 30px 60px -20px rgba(0,0,0,0.6);
    }
    .term-topbar {
        display:flex; align-items:center; gap:6px;
        background:#12241a; padding:10px 14px;
        border-bottom:1px solid rgba(255,255,255,0.06);
    }
    .term-topbar .dot { width:10px; height:10px; border-radius:50%; }
    .term-topbar .dot.r { background:#ff5f56; }
    .term-topbar .dot.y { background:#ffbd2e; }
    .term-topbar .dot.g { background:#27c93f; }
    .term-title {
        margin-left:14px; font-size:12px; color:rgba(255,255,255,0.55);
        font-family: ui-monospace, Menlo, monospace;
    }
    .term-tabs {
        display:flex; gap:4px; padding:8px 12px 0;
        background:#0a1510; border-bottom:1px solid rgba(255,255,255,0.06);
    }
    .term-tab {
        appearance:none; border:0; cursor:pointer;
        background:transparent; color:rgba(255,255,255,0.55);
        font: 600 12px/1 ui-monospace, Menlo, monospace;
        padding:8px 14px; border-radius:6px 6px 0 0;
        transition: background 0.15s ease, color 0.15s ease;
    }
    .term-tab:hover { color:#d4e5d8; background:rgba(255,255,255,0.04); }
    .term-tab.active {
        color:#a5d6a7; background:#0a1510;
        box-shadow: inset 0 -2px 0 #66bb6a;
    }
    .term-body {
        margin:0; padding:18px 20px; background:#0a1510;
        color:#d4e5d8; font-family: ui-monospace, Menlo, monospace;
        font-size:13px; line-height:1.65; white-space:pre-wrap; word-break:break-word;
    }
    .term-body .t-prompt { color:#66bb6a; font-weight:700; }
    .term-body .t-muted { color:rgba(255,255,255,0.5); }
    .term-body .t-ok { color:#a5d6a7; }

    /* FAQ */
    .faq { padding:100px 0; background:#fff; }
    .faq-grid { display:grid; grid-template-columns: repeat(2, 1fr); gap:16px; max-width:1000px; margin:0 auto; }
    @@media (max-width: 760px) { .faq-grid { grid-template-columns: 1fr; } }
    .faq-item {
        background:#fff; border:1px solid rgba(0,0,0,0.08);
        border-radius:14px; padding:18px 22px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .faq-item:hover { border-color:rgba(46,125,50,0.4); box-shadow: 0 8px 24px -12px rgba(16,42,26,0.15); }
    .faq-item summary {
        cursor:pointer; list-style:none;
        font-size:16px; font-weight:600; color:#102a1a;
        display:flex; align-items:center; justify-content:space-between; gap:12px;
    }
    .faq-item summary::-webkit-details-marker { display:none; }
    .faq-item summary::after {
        content:"+"; color:#2e7d32; font-size:22px; font-weight:700; line-height:1;
        transition: transform 0.2s ease;
    }
    .faq-item[open] summary::after { content:"−"; }
    .faq-item p {
        margin:12px 0 0; font-size:15px; color:#3a4a3e; line-height:1.6;
    }

    /* CTA band */
    .cta-band {
        background:
            radial-gradient(800px 300px at 80% 20%, rgba(255,255,255,0.1), transparent),
            linear-gradient(135deg, #1b5e20, #2e7d32);
        color:#fff; padding:80px 0;
        position:relative; overflow:hidden;
    }
    .cta-inner { text-align:center; position:relative; z-index:1; }
    .cta-band h2 {
        color:#fff; font-size:40px; font-weight:800; letter-spacing:-1px;
        margin:0 0 14px;
    }
    .cta-band p { font-size:17px; color:rgba(255,255,255,0.85); margin:0 0 28px; }
    .cta-buttons { display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }
    .cta-goat {
        position:absolute; right:-40px; top:50%; transform:translateY(-50%);
        width:280px; height:auto; opacity:0.85;
        pointer-events:none; z-index:0;
        filter: drop-shadow(0 10px 30px rgba(0,0,0,0.25));
    }
    @@media (max-width: 960px) {
        .cta-goat { width:200px; right:-30px; opacity:0.55; }
    }
    @@media (max-width: 720px) {
        .cta-band h2 { font-size:30px; }
        .cta-goat { display:none; }
    }

    /* Footer */
    .site-footer { background:#0f1f13; color:rgba(255,255,255,0.75); padding:40px 0; }
    .footer-inner {
        display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;
    }
    .footer-brand {
        display:flex; align-items:center; gap:8px;
        color:#fff; font-weight:700; font-size:18px;
    }
    .footer-links { display:flex; gap:22px; flex-wrap:wrap; }
    .footer-links a { color:rgba(255,255,255,0.75); text-decoration:none; font-size:14px; }
    .footer-links a:hover { color:#fff; }
    .footer-copy { font-size:13px; color:rgba(255,255,255,0.55); }
</style>

@code {
    // TODO: update this to the real repo URL once public.
    // The "Self-host" pitch on this landing page points to the OPEN-SOURCE /
    // self-hosted variant (chrisdfennell/GoatLab), not this SaaS repo
    // One MIT-licensed repo serves both editions. Saas:Enabled=false in
    // docker-compose.oss.yml gives a self-host build with no Stripe / no
    // marketplace; the same image runs at goatlab.app with Saas:Enabled=true.
    private const string RepoUrl = "https://github.com/chrisdfennell/GoatLabSaaS";

    private string _terminalTab = "hub";

    private List<BillingService.PublicPlan>? _plans;
    private List<RecentListing>? _recentListings;

    protected override async Task OnInitializedAsync()
    {
        try { _plans = await BillingApi.GetPublicPlansAsync(); }
        catch { _plans = new(); /* if the API is unreachable, show empty */ }

        try { _recentListings = await Http.GetFromJsonAsync<List<RecentListing>>("api/public/marketplace/recent?take=6"); }
        catch { _recentListings = new(); }
    }

    public record RecentListing(
        int Id, string Name, string? Breed, string Gender,
        int? AskingPriceCents, string FarmSlug, string FarmName, string? FarmLocation,
        string? PrimaryPhotoUrl, DateTime ListedAt);

    private static string ListedAgo(DateTime listedAt)
    {
        var diff = DateTime.UtcNow - listedAt;
        if (diff.TotalDays < 1) return "today";
        if (diff.TotalDays < 2) return "yesterday";
        if (diff.TotalDays < 30) return $"{(int)diff.TotalDays}d ago";
        if (diff.TotalDays < 365) return $"{(int)(diff.TotalDays / 30)}mo ago";
        return $"{(int)(diff.TotalDays / 365)}y ago";
    }

    // Middle plan in an odd-count list gets the "Most popular" badge.
    // For even counts, plan index floor(count/2)-1 is used — tweak if you want.
    private static bool IsFeaturedPlan(int index, int total)
        => total > 1 && index == total / 2;

    private static string CtaLabel(BillingService.PublicPlan plan)
    {
        if (plan.PriceMonthlyCents == 0) return "Start free";
        if (plan.TrialDays > 0) return $"Start {plan.TrialDays}-day trial";
        return $"Get {plan.Name}";
    }

    // "ShowRecords" → "Show records"
    private static string FeatureLabel(string feature)
    {
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < feature.Length; i++)
        {
            if (i > 0 && char.IsUpper(feature[i])) sb.Append(' ');
            sb.Append(i == 0 ? feature[i] : char.ToLower(feature[i]));
        }
        return sb.ToString();
    }

    private record Feature(string Title, string Body, string Icon, string Bg, string Fg);

