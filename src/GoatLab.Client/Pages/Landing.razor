@page "/"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@layout GoatLab.Client.Layout.LandingLayout
@inject NavigationManager Nav
@inject BillingService BillingApi
@inject HttpClient Http

<PageTitle>GoatLab — Herd management + buyer marketplace for goat farmers</PageTitle>

<HeadContent>
    <meta name="description" content="GoatLab is the all-in-one platform for goat farmers — herd records, health, breeding, milk, finances, AND a public marketplace where buyers find you, reserve goats with Stripe deposits, and verify lineage across every farm on the network. Works offline." />
</HeadContent>

@* ---------- TOP NAV ---------- *@
<header class="site-nav">
    <div class="nav-inner">
        <a href="/" class="brand" aria-label="GoatLab home">
            <img src="images/goat.svg" alt="" class="brand-mark" />
            <span>GoatLab</span>
        </a>
        <nav class="nav-links">
            <a href="#features">Features</a>
            <a href="#workflow">How it works</a>
            <a href="#compare">Compare</a>
            <a href="#pricing">Pricing</a>
            <a href="/marketplace">For sale</a>
            <a href="/breeds">Breeds</a>
            <a href="#self-host">Self-host</a>
            <a href="#faq">FAQ</a>
            @* Auth pair always visible (including mobile). On a phone the
               whole content nav collapses, but Sign in + Start free stay
               anchored top-right where the thumb is — no scrolling to the
               footer to find the login link. *@
            <a href="/login" class="nav-signin">Sign in</a>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/register" Class="nav-cta"
                       EndIcon="@Icons.Material.Filled.ArrowForward">Start free</MudButton>
        </nav>
    </div>
</header>

@* ---------- HERO ---------- *@
<section class="hero">
    <div class="hero-inner">
        <div class="hero-copy">
            <div class="eyebrow">
                <MudIcon Icon="@Icons.Material.Filled.Bolt" Style="font-size:16px;" />
                <span>The farm tool <strong>and</strong> the marketplace — built for goat people</span>
            </div>
            <h1>Run your whole goat operation. Sell to buyers across the network.</h1>
            <p class="lede">
                GoatLab tracks every goat, kidding, vet visit, milking, feed bag, and dollar.
                List animals on your public farm page where buyers find you, reserve with a Stripe
                deposit, and verify pedigree by walking the lineage graph across every farm on
                GoatLab. Works on any device. Works offline in the barn.
            </p>
            <div class="hero-ctas">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           Href="/register" EndIcon="@Icons.Material.Filled.ArrowForward">
                    Start free — no credit card
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                           Href="/marketplace" StartIcon="@Icons.Material.Filled.Search">
                    Browse the marketplace
                </MudButton>
            </div>
            <div class="hero-trust">
                <div class="trust-item">
                    <MudIcon Icon="@Icons.Material.Filled.OfflineBolt" Style="color:#2e7d32;" />
                    <span>Works offline</span>
                </div>
                <div class="trust-item">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Style="color:#2e7d32;" />
                    <span>Cross-farm lineage</span>
                </div>
                <div class="trust-item">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Style="color:#2e7d32;" />
                    <span>Your data, your farm</span>
                </div>
            </div>
        </div>

        <div class="hero-preview" aria-hidden="true">
            <div class="preview-frame">
                <div class="preview-topbar">
                    <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
                    <span class="preview-url">goatlab.app / dashboard</span>
                </div>
                <div class="preview-body">
                    <div class="pv-welcome">
                        <div>
                            <div class="pv-greet">Good morning!</div>
                            <div class="pv-sub">You have <b>47 goats</b> in your herd.</div>
                        </div>
                        <div class="pv-weather">
                            <MudIcon Icon="@Icons.Material.Filled.WbSunny" Style="color:#fff;font-size:40px;" />
                            <div>
                                <div class="pv-temp">72°F</div>
                                <div class="pv-cond">Clear · feels 70°</div>
                            </div>
                        </div>
                    </div>
                    <div class="pv-stats">
                        <div class="pv-stat pv-green"><b>47</b><span>Total</span></div>
                        <div class="pv-stat pv-teal"><b>32</b><span>Does</span></div>
                        <div class="pv-stat pv-blue"><b>11</b><span>Bucks</span></div>
                        <div class="pv-stat pv-pink"><b>6</b><span>Pregnant</span></div>
                        <div class="pv-stat pv-orange"><b>1</b><span>Sick</span></div>
                    </div>
                    <div class="pv-row">
                        <div class="pv-card">
                            <div class="pv-card-title">
                                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Style="color:#2e7d32;font-size:18px;" />
                                Milk · 30 days
                            </div>
                            <svg viewBox="0 0 200 60" class="pv-chart" preserveAspectRatio="none">
                                <polyline points="0,48 20,42 40,44 60,36 80,30 100,34 120,24 140,22 160,18 180,14 200,10"
                                          fill="none" stroke="#2e7d32" stroke-width="2.5" />
                                <polyline points="0,48 20,42 40,44 60,36 80,30 100,34 120,24 140,22 160,18 180,14 200,10 200,60 0,60"
                                          fill="rgba(46,125,50,0.12)" stroke="none" />
                            </svg>
                        </div>
                        <div class="pv-card">
                            <div class="pv-card-title">
                                <MudIcon Icon="@Icons.Material.Filled.History" Style="color:#2e7d32;font-size:18px;" />
                                Recent activity
                            </div>
                            <div class="pv-activity">
                                <div><span class="pv-dot pv-dot-blue"></span>Logged 3.2 lbs from Pearl · 2m ago</div>
                                <div><span class="pv-dot pv-dot-warn"></span>CDT booster for Clover · 1h ago</div>
                                <div><span class="pv-dot pv-dot-green"></span>Daisy added to herd · 3d ago</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ---------- JUST LISTED — live marketplace strip ---------- *@
@if (_recentListings is { Count: > 0 })
{
    <section class="just-listed">
        <div class="container">
            <div class="section-head">
                <div class="eyebrow dark">
                    <MudIcon Icon="@Icons.Material.Filled.NewReleases" Style="font-size:16px;" />
                    <span>Live on the marketplace</span>
                </div>
                <h2>Just listed</h2>
                <p>The freshest goats for sale across every farm on GoatLab — updated minutes ago.</p>
            </div>
            <div class="just-listed-grid">
                @foreach (var l in _recentListings)
                {
                    <a class="jl-card" href="@($"/pub/{l.FarmSlug}/{l.Id}")">
                        <div class="jl-photo @(string.IsNullOrEmpty(l.PrimaryPhotoUrl) ? "empty" : "")">
                            @if (!string.IsNullOrEmpty(l.PrimaryPhotoUrl))
                            {
                                <img src="@l.PrimaryPhotoUrl" alt="@l.Name" loading="lazy" />
                            }
                            else
                            {
                                <span>🐐</span>
                            }
                            @if ((DateTime.UtcNow - l.ListedAt).TotalDays <= 3)
                            {
                                <span class="jl-badge">Just listed</span>
                            }
                        </div>
                        <div class="jl-body">
                            <div class="jl-name">@l.Name</div>
                            <div class="jl-meta">@l.Gender@(string.IsNullOrEmpty(l.Breed) ? "" : $" · {l.Breed}")</div>
                            <div class="jl-farm">@l.FarmName@(string.IsNullOrEmpty(l.FarmLocation) ? "" : $" · {l.FarmLocation}")</div>
                            <div class="jl-bottom">
                                @if (l.AskingPriceCents.HasValue)
                                {
                                    <span class="jl-price">$@((l.AskingPriceCents.Value / 100m).ToString("N0"))</span>
                                }
                                else
                                {
                                    <span class="jl-price-na">Inquire</span>
                                }
                                <span class="jl-listed">@ListedAgo(l.ListedAt)</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
            <div class="just-listed-cta">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                           Href="/marketplace" EndIcon="@Icons.Material.Filled.ArrowForward">
                    Browse the full marketplace
                </MudButton>
            </div>
        </div>
    </section>
}

@* ---------- FEATURES ---------- *@
<section class="features" id="features">
    <div class="container">
        <div class="section-head">
            <div class="eyebrow dark">
                <MudIcon Icon="@Icons.Material.Filled.Dashboard" Style="font-size:16px;" />
                <span>Everything in one place</span>
            </div>
            <h2>Run the farm. Skip the spreadsheets.</h2>
            <p>GoatLab replaces the notebook on the barn wall, the breeding chart in the kitchen, and
               the sales receipts in the glovebox — with one app that works online or off.</p>
        </div>

        <div class="feature-grid">
            @foreach (var f in _features)
            {
                <div class="feature-card">
                    <div class="feature-icon" style="background:@f.Bg;color:@f.Fg;">
                        <MudIcon Icon="@f.Icon" Style="font-size:28px;" />
                    </div>
                    <h3>@f.Title</h3>
                    <p>@f.Body</p>
                </div>
            }
        </div>
    </div>
</section>

@* ---------- NETWORK ADVANTAGES ---------- *@
<section class="network" id="network">
    <div class="container">
        <div class="section-head">
            <div class="eyebrow dark">
                <MudIcon Icon="@Icons.Material.Filled.Hub" Style="font-size:16px;" />
                <span>Built like a network, not just a tool</span>
            </div>
            <h2>The advantages no single-farm app can match.</h2>
            <p>
                Most goat software locks your data inside one farm's account. GoatLab is multi-tenant
                from day one — which means your records can connect, transfer, and verify across every
                farm on the platform. Things that aren't possible without a network become possible.
            </p>
        </div>

        <div class="network-grid">
            <div class="network-card">
                <div class="network-icon" style="background:rgba(46,125,50,0.12);color:#2e7d32;">
                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Style="font-size:30px;" />
                </div>
                <h3>Cross-farm lineage</h3>
                <p>
                    Click any goat's pedigree and walk backwards across farms. Ancestors on other public
                    GoatLab farms link directly to their own lineage page — verifiable provenance,
                    indexable by Google. The closest thing the goat world has to a Carfax.
                </p>
                <a href="/breeds" class="network-link">Browse the directory →</a>
            </div>
            <div class="network-card">
                <div class="network-icon" style="background:rgba(63,81,181,0.12);color:#3f51b5;">
                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Style="font-size:30px;" />
                </div>
                <h3>Farm-to-farm transfers</h3>
                <p>
                    When two GoatLab farms transact, the animal carries its full history with it.
                    Pedigree, medical, weights, milk, photos — all move to the buyer's herd in one click.
                    No re-keying, no broken paperwork trail. Your records become more valuable the more
                    farms join.
                </p>
            </div>
            <div class="network-card">
                <div class="network-icon" style="background:rgba(229,57,53,0.12);color:#c62828;">
                    <MudIcon Icon="@Icons.Material.Filled.MedicalServices" Style="font-size:30px;" />
                </div>
                <h3>Vet share-links</h3>
                <p>
                    Generate a one-time URL and text it to your vet. They open it on their phone — no
                    app install, no signup — see the full medical history, and leave a note that lands
                    on your goat's timeline. Vets stay vets; their notes become your records.
                </p>
            </div>
            <div class="network-card">
                <div class="network-icon" style="background:rgba(46,125,50,0.12);color:#2e7d32;">
                    <MudIcon Icon="@Icons.Material.Filled.Storefront" Style="font-size:30px;" />
                </div>
                <h3>Public marketplace + Stripe deposits</h3>
                <p>
                    List a goat for sale and it appears on Google in hours, not weeks. Buyers can
                    filter by breed/sex/price/state, follow your farm to be notified when you list, and
                    reserve with a refundable deposit via Stripe Checkout — locked into your waitlist
                    automatically.
                </p>
                <a href="/breeds" class="network-link">See active listings →</a>
            </div>
        </div>
    </div>
</section>

@* ---------- WORKFLOW ---------- *@
<section class="workflow" id="workflow">
    <div class="container">
        <div class="section-head">
            <div class="eyebrow">
                <MudIcon Icon="@Icons.Material.Filled.Route" Style="font-size:16px;" />
                <span>How it works</span>
            </div>
            <h2>Set up in minutes. Useful on day one.</h2>
        </div>

        <div class="steps">
            <div class="step">
                <div class="step-num">1</div>
                <h3>Create your farm</h3>
                <p>Sign up and name your operation. Invite helpers later with their own roles.</p>
            </div>
            <div class="step">
                <div class="step-num">2</div>
                <h3>Add your herd</h3>
                <p>Enter goats one by one, or import a CSV (or an ADGA/AGS registry export). Lineage links automatically by registration number.</p>
            </div>
            <div class="step">
                <div class="step-num">3</div>
                <h3>Log what happens</h3>
                <p>Milkings, vet visits, breedings, sales. From your phone in the barn, even offline. Smart alerts catch what you forget.</p>
            </div>
            <div class="step">
                <div class="step-num">4</div>
                <h3>Go public when ready</h3>
                <p>Flip on your public farm page, list goats for sale, and buyers find you on the marketplace. Reservations come in with Stripe deposits attached.</p>
            </div>
            <div class="step">
                <div class="step-num">5</div>
                <h3>See the whole picture</h3>
                <p>Reports, forecasts, COI calculations, mate recommendations — so you can act, not guess.</p>
            </div>
        </div>
    </div>
</section>

@* ---------- COMPARISON ---------- *@
@* Capability-focused, no competitor prices on purpose — competitor pricing
   shifts often and "we're cheaper" is a fragile pitch. Differentiation is
   the marketplace + cross-farm pedigree, which spreadsheets and single-farm
   herd apps both lack. *@
<section class="compare" id="compare">
    <div class="container">
        <div class="section-head">
            <div class="eyebrow dark">
                <MudIcon Icon="@Icons.Material.Filled.CompareArrows" Style="font-size:16px;" />
                <span>vs. the alternatives</span>
            </div>
            <h2>Spreadsheets, generic herd apps, or Facebook groups?</h2>
            <p>Most goat farms juggle three tools today. GoatLab is one tool that does all three jobs — and a few more.</p>
        </div>

        <div class="compare-table-wrap">
            <table class="compare-table">
                <thead>
                    <tr>
                        <th>Capability</th>
                        <th class="us">GoatLab</th>
                        <th>Spreadsheets</th>
                        <th>Generic herd app</th>
                        <th>Facebook&nbsp;group</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Goat records (health, breeding, milk, finance)</td>
                        <td class="us">✅</td>
                        <td>⚠️ DIY</td>
                        <td>✅</td>
                        <td>❌</td>
                    </tr>
                    <tr>
                        <td>Public farm page with goats for sale</td>
                        <td class="us">✅</td>
                        <td>❌</td>
                        <td>❌</td>
                        <td>⚠️ posts only</td>
                    </tr>
                    <tr>
                        <td>Cross-farm marketplace at <code>/marketplace</code></td>
                        <td class="us">✅</td>
                        <td>❌</td>
                        <td>❌</td>
                        <td>⚠️ scrolling timeline</td>
                    </tr>
                    <tr>
                        <td>Pedigree that walks across farms</td>
                        <td class="us">✅</td>
                        <td>❌</td>
                        <td>❌ trapped per-farm</td>
                        <td>❌</td>
                    </tr>
                    <tr>
                        <td>Stripe deposits direct from listing</td>
                        <td class="us">✅</td>
                        <td>❌</td>
                        <td>❌</td>
                        <td>❌</td>
                    </tr>
                    <tr>
                        <td>Buyer messaging in one inbox</td>
                        <td class="us">✅</td>
                        <td>❌</td>
                        <td>❌</td>
                        <td>⚠️ DM chaos</td>
                    </tr>
                    <tr>
                        <td>Goat transfer carries the full record</td>
                        <td class="us">✅</td>
                        <td>❌</td>
                        <td>❌</td>
                        <td>❌</td>
                    </tr>
                    <tr>
                        <td>Vet share-link without a login</td>
                        <td class="us">✅</td>
                        <td>❌</td>
                        <td>⚠️ varies</td>
                        <td>❌</td>
                    </tr>
                    <tr>
                        <td>Works offline in the barn (PWA)</td>
                        <td class="us">✅</td>
                        <td>⚠️ if local</td>
                        <td>⚠️ varies</td>
                        <td>❌</td>
                    </tr>
                    <tr>
                        <td>Open source, self-host on your hardware</td>
                        <td class="us">✅</td>
                        <td>—</td>
                        <td>❌</td>
                        <td>❌</td>
                    </tr>
                    <tr>
                        <td>Free tier that's actually useful</td>
                        <td class="us">✅ Homestead</td>
                        <td>✅ free</td>
                        <td>⚠️ varies</td>
                        <td>✅ free</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="compare-footnote">
            ✅ = built-in &nbsp; ⚠️ = partial / depends on you &nbsp; ❌ = not available &nbsp; — = not applicable.
            We don't list specific competitor prices because they change — focus on what each tool actually does for your farm.
        </p>
    </div>
</section>

@* ---------- PRICING ---------- *@
<section class="pricing" id="pricing">
    <div class="container">
        <div class="section-head">
            <div class="eyebrow dark">
                <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Style="font-size:16px;" />
                <span>Simple, honest pricing</span>
            </div>
            <h2>Start free. Grow when you're ready.</h2>
        </div>

        <div class="plan-grid">
            @if (_plans is null)
            {
                <MudProgressCircular Indeterminate="true" />
            }
            else
            {
                @for (var i = 0; i < _plans.Count; i++)
                {
                    var plan = _plans[i];
                    var featured = IsFeaturedPlan(i, _plans.Count);
                    <div class="plan @(featured ? "featured" : "")">
                        @if (featured) { <div class="plan-badge">Most popular</div> }
                        <div class="plan-name">@plan.Name</div>
                        <div class="plan-price">
                            @(plan.PriceMonthlyCents == 0 ? "Free" : $"${plan.PriceMonthlyCents / 100m:0}")
                            <span>@(plan.PriceMonthlyCents == 0 ? "forever" : "/ month")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(plan.Description))
                        {
                            <div class="plan-line">@plan.Description</div>
                        }
                        <ul>
                            <li>
                                <MudIcon Icon="@Icons.Material.Filled.Check" />
                                @(plan.MaxGoats?.ToString() ?? "Unlimited") goats
                            </li>
                            <li>
                                <MudIcon Icon="@Icons.Material.Filled.Check" />
                                @(plan.MaxUsers?.ToString() ?? "Unlimited") users
                            </li>
                            @foreach (var f in plan.Features.Where(f => f.Enabled))
                            {
                                <li><MudIcon Icon="@Icons.Material.Filled.Check" /> @FeatureLabel(f.Feature)</li>
                            }
                        </ul>
                        <MudButton Variant="@(featured ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary" FullWidth Href="/register">
                            @CtaLabel(plan)
                        </MudButton>
                    </div>
                }
            }
        </div>
    </div>
</section>

@* ---------- SELF-HOST / DOCKER ---------- *@
<section class="self-host" id="self-host">
    <div class="container self-host-inner">
        <div class="self-host-copy">
            <div class="eyebrow">
                <MudIcon Icon="@Icons.Material.Filled.Storage" Style="font-size:16px;" />
                <span>Own your data</span>
            </div>
            <h2>Run GoatLab on your own hardware.</h2>
            <p>
                Prefer to keep your farm data off the cloud? GoatLab ships as a single Docker container.
                Deploy it on a Raspberry Pi in the barn, a NAS in the office, or a VPS — whatever you
                already have. Pull the prebuilt image from Docker Hub or clone the repo and build it
                yourself — either way, one <code>docker compose up</code> and the whole app is running
                locally with its own SQL Server database and media volume.
            </p>
            <ul class="self-host-list">
                <li><MudIcon Icon="@Icons.Material.Filled.Check" /> Same app you see here — no feature lock-out</li>
                <li><MudIcon Icon="@Icons.Material.Filled.Check" /> Data stays on your network, in your volumes</li>
                <li><MudIcon Icon="@Icons.Material.Filled.Check" /> Runs on Linux, QNAP, Synology, and Windows</li>
                <li><MudIcon Icon="@Icons.Material.Filled.Check" /> Free and open — source on GitHub</li>
            </ul>
            <div class="self-host-ctas">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           Href="@RepoUrl" Target="_blank"
                           StartIcon="@Icons.Custom.Brands.GitHub">
                    View on GitHub
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large"
                           Href="@($"{RepoUrl}#self-hosting")" Target="_blank"
                           EndIcon="@Icons.Material.Filled.ArrowForward">
                    Read the docs
                </MudButton>
            </div>
        </div>

        <div class="self-host-terminal">
            <div class="term-topbar">
                <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
                <span class="term-title">~/goatlab</span>
            </div>
            <div class="term-tabs" role="tablist">
                <button type="button"
                        class="@(_terminalTab == "hub" ? "term-tab active" : "term-tab")"
                        role="tab"
                        aria-selected="@(_terminalTab == "hub")"
                        @onclick="@(() => _terminalTab = "hub")">
                    Docker Hub
                </button>
                <button type="button"
                        class="@(_terminalTab == "source" ? "term-tab active" : "term-tab")"
                        role="tab"
                        aria-selected="@(_terminalTab == "source")"
                        @onclick="@(() => _terminalTab = "source")">
                    From source
                </button>
            </div>
            @if (_terminalTab == "hub")
            {
                <pre class="term-body"><span class="t-muted"># Pull the prebuilt image from Docker Hub — no source tree needed</span>
<span class="t-prompt">$</span> mkdir goatlab && cd goatlab
<span class="t-prompt">$</span> curl -O https://raw.githubusercontent.com/chrisdfennell/GoatLabSaaS/main/docker-compose.oss.yml
<span class="t-prompt">$</span> curl -o .env https://raw.githubusercontent.com/chrisdfennell/GoatLabSaaS/main/.env.example
<span class="t-muted"># edit .env, set SA_PASSWORD</span>
<span class="t-prompt">$</span> docker compose -f docker-compose.oss.yml up -d
<span class="t-muted">
[+] Pulling fennch/goatlab:latest (multi-arch)
[+] Running 3/3
 ✔ Container goatlab-sqlserver    Healthy
 ✔ Container goatlab              Started</span>

<span class="t-prompt">$</span> open http://localhost:8090
<span class="t-ok">  GoatLab is up. Start logging goats.</span>
</pre>
            }
            else
            {
                <pre class="term-body"><span class="t-muted"># Clone the repo and build the image locally</span>
