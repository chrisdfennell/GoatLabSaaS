<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color:#c62828;">
            <MudIcon Icon="@Icons.Material.Filled.Warning" /> Type the @Label to confirm
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
            This action cannot be undone. To confirm, type the @Label below.
        </MudText>
        <MudText Typo="Typo.body2" Class="mb-2" Style="text-transform:capitalize;">
            @Label: <code>@ExpectedValue</code>
        </MudText>
        <MudTextField @bind-Value="_typed"
                      Label="@($"Type the {Label}")"
                      Variant="Variant.Outlined"
                      Immediate
                      AutoFocus
                      Placeholder="@ExpectedValue" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(!IsMatch)" OnClick="Confirm">
            Permanently delete
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>
    /// The exact value the operator must type to enable the destructive action.
    /// Email for users, slug for tenants — comparison is case-insensitive
    /// because user emails / slugs are stored lowercased on the server.
    /// </summary>
    [Parameter] public string ExpectedValue { get; set; } = "";

    /// <summary>Lowercase noun shown in the prompt — "email", "farm slug", etc.</summary>
    [Parameter] public string Label { get; set; } = "value";

    /// <summary>Back-compat alias for callers that still pass ExpectedEmail.</summary>
    [Parameter]
    public string ExpectedEmail
    {
        get => ExpectedValue;
        set => ExpectedValue = value;
    }

    private string _typed = "";

    private bool IsMatch =>
        !string.IsNullOrEmpty(_typed)
        && string.Equals(_typed.Trim(), ExpectedValue, StringComparison.OrdinalIgnoreCase);

    private void Cancel() => MudDialog.Cancel();
    private void Confirm() => MudDialog.Close(DialogResult.Ok(_typed.Trim()));
}
