@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<header class="auth-layout-header">
    <a href="/" class="auth-layout-brand">
        <span class="auth-layout-brand-emoji">🐐</span>
        <span class="auth-layout-brand-text">GoatLab</span>
    </a>
    <a href="/" class="auth-layout-back">← Back to home</a>
</header>

<MudMainContent>
    <MudContainer MaxWidth="MaxWidth.Small">
        @Body
    </MudContainer>
</MudMainContent>

<style>
    .auth-layout-header {
        max-width: 960px;
        margin: 0 auto;
        padding: 16px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }
    .auth-layout-brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        font-size: 1.15rem;
        color: #1b5e20;
        text-decoration: none;
    }
    .auth-layout-brand:hover { text-decoration: none; opacity: 0.85; }
    .auth-layout-brand-emoji { font-size: 1.4rem; line-height: 1; }
    .auth-layout-back {
        font-size: 0.92rem;
        color: #4a5a51;
        text-decoration: none;
    }
    .auth-layout-back:hover { color: #1b5e20; text-decoration: underline; }
</style>
