@using GoatLab.Server.Controllers
@model BuyerDashboardVm
@{
    ViewData["Title"] = "My buyer dashboard — GoatLab";
    ViewData["Robots"] = "noindex, nofollow";
}

<div class="breadcrumbs">
    <a href="/">Home</a>
    <span class="sep">›</span>
    <span>My dashboard</span>
</div>

<div class="dashboard-header">
    <div>
        <div class="eyebrow">Buyer dashboard</div>
        <h1 style="margin:6px 0 4px 0;">Welcome back</h1>
        <p style="margin:0;color:#6b7a70;">Signed in as <strong>@Model.Email</strong></p>
    </div>
    <form method="post" action="/api/buyer/auth/logout" id="logout-form">
        <button type="button" class="logout-btn" onclick="(async function(){await fetch('/api/buyer/auth/logout',{method:'POST'});window.location='/marketplace';})()">Sign out</button>
    </form>
</div>

<div class="dashboard-grid">

    <section class="dashboard-card">
        <h2>⭐ Saved listings <span class="count">@Model.Saved.Count</span></h2>
        @if (Model.Saved.Count == 0)
        {
            <p class="card-empty">
                Browse the <a href="/marketplace">marketplace</a> and tap <strong>Save</strong> on a listing to add it here.
            </p>
        }
        else
        {
            <div class="saved-grid">
                @foreach (var s in Model.Saved)
                {
                    <a class="saved-card @(s.StillListed ? "" : "delisted")" href="/pub/@s.FarmSlug/@s.GoatId">
                        <div class="saved-photo @(string.IsNullOrEmpty(s.PrimaryPhotoUrl) ? "empty" : "")">
                            @if (!string.IsNullOrEmpty(s.PrimaryPhotoUrl))
                            {
                                <img src="@s.PrimaryPhotoUrl" alt="@s.Name" loading="lazy" />
                            }
                            else
                            {
                                <span>🐐</span>
                            }
                            @if (!s.StillListed)
                            {
                                <span class="delisted-badge">No longer listed</span>
                            }
                        </div>
                        <div class="saved-body">
                            <div class="saved-name">@s.Name</div>
                            <div class="saved-meta">@s.Gender@(string.IsNullOrEmpty(s.Breed) ? "" : $" · {s.Breed}")</div>
                            <div class="saved-farm">@s.FarmName@(string.IsNullOrEmpty(s.FarmLocation) ? "" : $" · {s.FarmLocation}")</div>
                            <div class="saved-bottom">
                                @if (s.AskingPriceCents.HasValue)
                                {
                                    <span class="saved-price">$@((s.AskingPriceCents.Value / 100m).ToString("N0"))</span>
                                }
                                <button type="button" class="unsave-btn" data-id="@s.GoatId"
                                        onclick="event.preventDefault();event.stopPropagation();window.unsaveListing(this);">Remove</button>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </section>

    <section class="dashboard-card">
        <h2>💬 Inquiries <span class="count">@Model.Inquiries.Count</span></h2>
        @if (Model.Inquiries.Count == 0)
        {
            <p class="card-empty">
                Inquiries you send to sellers from public listings show up here so you can find the conversation later.
            </p>
        }
        else
        {
            <ul class="inquiry-list">
                @foreach (var i in Model.Inquiries)
                {
                    <li class="@(i.Status == "Closed" ? "closed" : "")">
                        <strong>@i.GoatName</strong> at <a href="/pub/@i.FarmSlug">@i.FarmName</a>
                        <span class="inq-meta">@i.MessageCount @(i.MessageCount == 1 ? "msg" : "msgs") · @i.LastMessageAt.ToLocalTime().ToString("MMM d") · @i.Status.ToLower()</span>
                    </li>
                }
            </ul>
            <p style="font-size:0.85rem;color:#6b7a70;margin-top:8px;">
                Reply to any seller email to continue a conversation — replies thread automatically.
            </p>
        }
    </section>

    <section class="dashboard-card">
        <h2>🐐 Followed farms <span class="count">@Model.Follows.Count</span></h2>
        @if (Model.Follows.Count == 0)
        {
            <p class="card-empty">
                When you click "Follow this farm" on a public farm page, you'll get one email when they list a new goat.
                Followed farms show up here.
            </p>
        }
        else
        {
            <ul class="follow-list">
                @foreach (var f in Model.Follows)
                {
                    <li>
                        <a href="/pub/@f.FarmSlug">@f.FarmName</a>
                        @if (!string.IsNullOrEmpty(f.FarmLocation))
                        {
                            <span class="inq-meta"> · @f.FarmLocation</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="dashboard-card">
        <h2>🔔 Saved searches <span class="count">@Model.Alerts.Count</span></h2>
        @if (Model.Alerts.Count == 0)
        {
            <p class="card-empty">
                On the marketplace or any breed page, set filters and click "Save search" to get notified when matching goats are listed.
            </p>
        }
        else
        {
            <ul class="alert-list">
                @foreach (var a in Model.Alerts)
                {
                    <li>
                        @if (!string.IsNullOrEmpty(a.BreedSlug))
                        {
                            <strong>@a.BreedSlug</strong>
                        }
                        else
                        {
                            <strong>Any breed</strong>
                        }
                        @if (!string.IsNullOrEmpty(a.Sex))
                        {
                            <span> · @a.Sex</span>
                        }
                        @if (a.MinPriceCents.HasValue || a.MaxPriceCents.HasValue)
                        {
                            <span> · $@((a.MinPriceCents ?? 0) / 100)–$@((a.MaxPriceCents ?? 0) / 100)</span>
                        }
                        @if (!string.IsNullOrEmpty(a.State))
                        {
                            <span> · @a.State</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>

</div>

<style>
    .dashboard-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
    .logout-btn { background: transparent; border: 1px solid #ccc; color: #4a5a51; padding: 8px 14px; border-radius: 8px; font-size: 0.9rem; cursor: pointer; font-family: inherit; }
    .logout-btn:hover { background: #f5f5f5; }

    .dashboard-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 18px; }
    @@media (max-width: 800px) { .dashboard-grid { grid-template-columns: 1fr; } }

    .dashboard-card { background: #fff; border: 1px solid #e0e0e0; border-radius: 12px; padding: 18px; }
    .dashboard-card h2 { display: flex; align-items: center; gap: 8px; margin: 0 0 12px 0; font-size: 1.1rem; }
    .dashboard-card h2 .count { font-size: 0.78rem; color: #6b7a70; font-weight: 500; background: #f1f4f1; padding: 2px 8px; border-radius: 999px; }
    .card-empty { color: #6b7a70; font-size: 0.92rem; margin: 0; }

    .saved-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
    .saved-card { display: flex; flex-direction: column; background: #fff; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; text-decoration: none; color: inherit; transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .saved-card:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(0,0,0,0.08); text-decoration: none; }
    .saved-card.delisted { opacity: 0.65; }
    .saved-photo { aspect-ratio: 1 / 1; background: #f5f5f5; overflow: hidden; position: relative; }
    .saved-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .saved-photo.empty { display: flex; align-items: center; justify-content: center; font-size: 2.5rem; color: #bbb; }
    .delisted-badge { position: absolute; top: 6px; left: 6px; background: rgba(0,0,0,0.65); color: #fff; font-size: 0.65rem; padding: 2px 6px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.3px; }
    .saved-body { padding: 10px 12px; }
    .saved-name { font-weight: 700; font-size: 0.95rem; }
    .saved-meta { font-size: 0.78rem; color: #6b7a70; margin-top: 2px; }
    .saved-farm { font-size: 0.74rem; color: #4a5a51; margin-top: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .saved-bottom { display: flex; justify-content: space-between; align-items: center; gap: 6px; margin-top: 6px; }
    .saved-price { color: #2e7d32; font-weight: 700; font-size: 0.95rem; }
    .unsave-btn { background: transparent; border: 0; color: #c62828; font-size: 0.75rem; cursor: pointer; padding: 2px 6px; font-family: inherit; }
    .unsave-btn:hover { text-decoration: underline; }

    .inquiry-list, .follow-list, .alert-list { list-style: none; padding: 0; margin: 0; }
    .inquiry-list li, .follow-list li, .alert-list li { padding: 8px 0; border-bottom: 1px solid #f0f0f0; font-size: 0.92rem; }
    .inquiry-list li:last-child, .follow-list li:last-child, .alert-list li:last-child { border-bottom: 0; }
    .inquiry-list li.closed { opacity: 0.65; }
    .inq-meta { color: #6b7a70; font-size: 0.78rem; }
</style>

<script>
    window.unsaveListing = async function (btn) {
        var id = btn.getAttribute('data-id');
        if (!id) return;
        var card = btn.closest('.saved-card');
        try {
            var resp = await fetch('/api/buyer/saved/' + encodeURIComponent(id), { method: 'DELETE' });
            if (resp.ok) {
                if (card) card.remove();
                // Update count chip
                var count = document.querySelector('.dashboard-card h2 .count');
                if (count) {
                    var n = parseInt(count.textContent, 10) - 1;
                    count.textContent = n;
                }
            }
        } catch (e) { /* swallow */ }
    };
</script>
