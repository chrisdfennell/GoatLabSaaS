@{
    ViewData["Title"] = "Sign-in link invalid — GoatLab";
    ViewData["Robots"] = "noindex, follow";
}

<div class="empty-state" style="max-width:520px;margin:48px auto;">
    <div class="icon">⚠️</div>
    <h2 style="margin:8px 0;">That sign-in link didn't work</h2>
    <p style="margin:8px 0;">
        The link was either already used, expired (links last 30 minutes), or copied incorrectly.
        No problem — request a fresh one and try again.
    </p>
    <p style="margin-top:18px;">
        <a class="cta-button" href="/buyer/sign-in">Send me a new link</a>
    </p>
</div>
