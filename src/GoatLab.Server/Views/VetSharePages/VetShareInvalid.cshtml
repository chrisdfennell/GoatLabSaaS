@{
    ViewData["Title"] = "Link not valid — GoatLab";
    ViewData["Description"] = "This vet share link is invalid, expired, or has been revoked.";
    Context.Response.StatusCode = 404;
}

<div class="empty-state" style="margin-top: 40px;">
    <div class="icon">🔒</div>
    <h1 style="margin: 8px 0;">This share link isn't valid</h1>
    <p>
        The link may have expired, been revoked, or copied incorrectly.
        Ask the farmer to send you a fresh link from their goat's record.
    </p>
    <p>
        <a class="cta-button" href="/breeds">Visit GoatLab</a>
    </p>
</div>
