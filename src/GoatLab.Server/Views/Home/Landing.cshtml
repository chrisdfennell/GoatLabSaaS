@model GoatLab.Server.Models.LandingPageModel
@{
    Layout = null;
    var title = ViewData["Title"] as string ?? "GoatLab";
    var description = ViewData["Description"] as string ?? "Herd management + buyer marketplace for goat farmers.";
    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}/";
    var ogImage = $"{Context.Request.Scheme}://{Context.Request.Host}/images/icon-192.png";
    var jsonLd = ViewData["JsonLd"] as string;
    const string RepoUrl = "https://github.com/chrisdfennell/GoatLabSaaS";

    // Feature cards (ported from Landing.razor's _features array). Material
    // Symbols ligature names replace the MudBlazor SVG icons used in the SPA.
    var features = new (string Title, string Body, string Symbol, string Bg, string Fg)[]
    {
        ("Complete herd records",
            "Every goat has a profile: tag, breed, birthday, photos, documents. Pedigree trees, COI calculator, and a single Timeline tab that pulls every event for that animal into one chronological scroll.",
            "pets", "rgba(46,125,50,0.12)", "#2e7d32"),
        ("Health, vaccinations & vet share-links",
            "Log treatments, schedule recurring doses, track medication withdrawal holds. Generate a one-time URL your vet can open without signing up — they leave a note that lands on your timeline.",
            "local_hospital", "rgba(229,57,53,0.12)", "#c62828"),
        ("Breeding, kidding & mate matches",
            "Record pairings, track pregnancies, get due-date alerts. GoatLab ranks every buck in your herd by projected offspring COI plus daughter production — turn a recommendation into a breeding record in one click.",
            "favorite", "rgba(236,64,122,0.12)", "#c2185b"),
        ("Milk production tracking",
            "One-tap milk logging from your phone in the parlor. See 30-day trends, per-doe performance, lactation curves, DHI test days, and 305-day projections.",
            "water_drop", "rgba(25,118,210,0.12)", "#1976d2"),
        ("Sales, finances & buyer waitlist",
            "Track every sale, expense, and feed bag. Cost-per-goat reports. A built-in buyer waitlist lets interested customers reserve animals with a Stripe deposit — no PayPal back-and-forth.",
            "attach_money", "rgba(46,125,50,0.12)", "#2e7d32"),
        ("Inventory & feed",
            "Stay on top of feed, minerals, and medications. Consumption tracking, reorder forecasts, low-stock alerts — before you run out, not after.",
            "inventory_2", "rgba(239,108,0,0.12)", "#ef6c00"),
        ("Farm map & pasture rotation",
            "Draw pastures and barns on an interactive map. Assign goats to pens. Track rotation history and KML-export the whole farm.",
            "map", "rgba(21,101,192,0.12)", "#1565c0"),
        ("Smart alerts & reminders",
            "Overdue meds, upcoming kiddings, low feed, weight drops — everything due today, this week, next month. Push notifications to your phone and a daily email digest.",
            "notifications_active", "rgba(123,31,162,0.12)", "#6a1b9a"),
        ("Reports & forecasting",
            "P&L, milk trends, kidding survival, parasite scoring, progeny rollups, mortality. Plus 90-day forecasts on cash flow, kidding load, and milk production.",
            "bar_chart", "rgba(0,121,107,0.12)", "#00796b"),
        ("Public marketplace listing",
            "Every farm gets a public page at goatlab.app/pub/your-farm. Browseable breed directory, filter by sex/price/state, schema.org structured data so Google ranks you. Buyers can follow your farm and get notified when you list.",
            "storefront", "rgba(46,125,50,0.12)", "#2e7d32"),
        ("Farm-to-farm transfers",
            "When you sell to another GoatLab farm, the goat's full record — pedigree, medical history, weights, photos — moves with it. The buyer's herd is populated instantly. No re-keying.",
            "swap_horiz", "rgba(63,81,181,0.12)", "#3f51b5"),
        ("Cross-farm lineage graph",
            "Walk a goat's pedigree across the entire GoatLab network. Underlined ancestors link to whichever public farm currently holds them — the closest thing to a Carfax for goats.",
            "account_tree", "rgba(46,125,50,0.12)", "#2e7d32"),
        ("API, webhooks & offline PWA",
            "Tenant API keys for programmatic access. Outbound webhooks signed with HMAC for goat / sale / kidding events. Install GoatLab to your phone or tablet — works offline in the barn, syncs when you're back online.",
            "code", "rgba(55,71,79,0.12)", "#37474f"),
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <link rel="canonical" href="@canonical" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />

    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@300;400;500;600;700&family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@@24,400,0,0&display=swap" rel="stylesheet" />
    <link href="/css/landing.css" rel="stylesheet" />

    @* SSR adaptations: the SPA got button + icon styling from MudBlazor's CSS,
       which this server-rendered page does not load. These rules reproduce the
       handful of button/icon looks the landing relies on. *@
    <style>
        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }
        @@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
        body.landing-root {
            margin: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined';
            font-weight: normal; font-style: normal; line-height: 1;
            letter-spacing: normal; text-transform: none; display: inline-block;
            white-space: nowrap; word-wrap: normal; direction: ltr;
            font-feature-settings: 'liga'; -webkit-font-smoothing: antialiased;
            vertical-align: middle; font-size: 20px;
        }
        .brand-mark { width: 28px; height: 28px; display: block; }
        .footer-brand-mark { width: 26px; height: 26px; display: block; }
        .btn {
            display: inline-flex; align-items: center; justify-content: center; gap: 8px;
            padding: 9px 18px; border-radius: 8px; font-weight: 600; font-size: 15px;
            text-decoration: none; cursor: pointer; border: 1px solid transparent;
            font-family: inherit; line-height: 1.4;
            transition: background .15s ease, border-color .15s ease, color .15s ease, box-shadow .15s ease;
        }
        .btn:hover { text-decoration: none; }
        .btn-lg { padding: 13px 24px; font-size: 16px; }
        .btn-filled { background: #2e7d32; color: #fff; }
        .btn-filled:hover { background: #1b5e20; color: #fff; }
        .btn-outlined { background: transparent; color: #2e7d32; border-color: #2e7d32; }
        .btn-outlined:hover { background: rgba(46,125,50,0.08); color: #1b5e20; }
        .btn-text { background: transparent; color: inherit; }
        .btn-text:hover { background: rgba(255,255,255,0.12); }
        .btn .material-symbols-outlined { font-size: 20px; }
        .plan ul li .material-symbols-outlined { color: #2e7d32; font-size: 18px; }
        .self-host-list li .material-symbols-outlined { color: #66bb6a; font-size: 18px; }
        .gh-icon { width: 18px; height: 18px; fill: currentColor; vertical-align: middle; }
        a:focus-visible, button:focus-visible { outline: 2px solid #2e7d32; outline-offset: 2px; border-radius: 4px; }
        @@media (max-width: 720px) { .nav-cta .btn-icon-end { display: none; } }
    </style>

    @if (!string.IsNullOrEmpty(jsonLd))
    {
        @Html.Raw($"<script type=\"application/ld+json\">{jsonLd}</script>")
    }
</head>
<body class="landing-root">

    @* ---------- TOP NAV ---------- *@
    <header class="site-nav">
        <div class="nav-inner">
            <a href="/" class="brand" aria-label="GoatLab home">
                <img src="/images/goat.svg" alt="" class="brand-mark" />
                <span>GoatLab</span>
            </a>
            <nav class="nav-links">
                <a href="#features">Features</a>
                <a href="#workflow">How it works</a>
                <a href="#compare">Compare</a>
                <a href="#pricing">Pricing</a>
                <a href="/marketplace">For sale</a>
                <a href="/breeds">Breeds</a>
                <a href="#self-host">Self-host</a>
                <a href="#faq">FAQ</a>
                <a href="/login" class="nav-signin">Sign in</a>
                <a href="/register" class="btn btn-filled nav-cta">Start free <span class="material-symbols-outlined btn-icon-end">arrow_forward</span></a>
            </nav>
        </div>
    </header>

    @* ---------- HERO ---------- *@
    <section class="hero">
        <div class="hero-inner">
            <div class="hero-copy">
                <div class="eyebrow">
                    <span class="material-symbols-outlined" style="font-size:16px;">bolt</span>
                    <span>The farm tool <strong>and</strong> the marketplace — built for goat people</span>
                </div>
                <h1>Run your whole goat operation. Sell to buyers across the network.</h1>
                <p class="lede">
                    GoatLab tracks every goat, kidding, vet visit, milking, feed bag, and dollar.
                    List animals on your public farm page where buyers find you, reserve with a Stripe
                    deposit, and verify pedigree by walking the lineage graph across every farm on
                    GoatLab. Works on any device. Works offline in the barn.
                </p>
                <div class="hero-ctas">
                    <a href="/register" class="btn btn-filled btn-lg">Start free — no credit card <span class="material-symbols-outlined">arrow_forward</span></a>
                    <a href="/marketplace" class="btn btn-outlined btn-lg"><span class="material-symbols-outlined">search</span> Browse the marketplace</a>
                </div>
                <div class="hero-trust">
                    <div class="trust-item">
                        <span class="material-symbols-outlined" style="color:#2e7d32;">offline_bolt</span>
                        <span>Works offline</span>
                    </div>
                    <div class="trust-item">
                        <span class="material-symbols-outlined" style="color:#2e7d32;">account_tree</span>
                        <span>Cross-farm lineage</span>
                    </div>
                    <div class="trust-item">
                        <span class="material-symbols-outlined" style="color:#2e7d32;">lock</span>
                        <span>Your data, your farm</span>
                    </div>
                </div>
            </div>

            <div class="hero-preview" aria-hidden="true">
                <div class="preview-frame">
                    <div class="preview-topbar">
                        <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
                        <span class="preview-url">goatlab.app / dashboard</span>
                    </div>
                    <div class="preview-body">
                        <div class="pv-welcome">
                            <div>
                                <div class="pv-greet">Good morning!</div>
                                <div class="pv-sub">You have <b>47 goats</b> in your herd.</div>
                            </div>
                            <div class="pv-weather">
                                <span class="material-symbols-outlined" style="color:#fff;font-size:40px;">wb_sunny</span>
                                <div>
                                    <div class="pv-temp">72°F</div>
                                    <div class="pv-cond">Clear · feels 70°</div>
                                </div>
                            </div>
                        </div>
                        <div class="pv-stats">
                            <div class="pv-stat pv-green"><b>47</b><span>Total</span></div>
                            <div class="pv-stat pv-teal"><b>32</b><span>Does</span></div>
                            <div class="pv-stat pv-blue"><b>11</b><span>Bucks</span></div>
                            <div class="pv-stat pv-pink"><b>6</b><span>Pregnant</span></div>
                            <div class="pv-stat pv-orange"><b>1</b><span>Sick</span></div>
                        </div>
                        <div class="pv-row">
                            <div class="pv-card">
                                <div class="pv-card-title">
                                    <span class="material-symbols-outlined" style="color:#2e7d32;font-size:18px;">trending_up</span>
                                    Milk · 30 days
                                </div>
                                <svg viewBox="0 0 200 60" class="pv-chart" preserveAspectRatio="none">
                                    <polyline points="0,48 20,42 40,44 60,36 80,30 100,34 120,24 140,22 160,18 180,14 200,10"
                                              fill="none" stroke="#2e7d32" stroke-width="2.5" />
                                    <polyline points="0,48 20,42 40,44 60,36 80,30 100,34 120,24 140,22 160,18 180,14 200,10 200,60 0,60"
                                              fill="rgba(46,125,50,0.12)" stroke="none" />
                                </svg>
                            </div>
                            <div class="pv-card">
                                <div class="pv-card-title">
                                    <span class="material-symbols-outlined" style="color:#2e7d32;font-size:18px;">history</span>
                                    Recent activity
                                </div>
                                <div class="pv-activity">
                                    <div><span class="pv-dot pv-dot-blue"></span>Logged 3.2 lbs from Pearl · 2m ago</div>
                                    <div><span class="pv-dot pv-dot-warn"></span>CDT booster for Clover · 1h ago</div>
                                    <div><span class="pv-dot pv-dot-green"></span>Daisy added to herd · 3d ago</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* ---------- JUST LISTED — live marketplace strip ---------- *@
    @if (Model.RecentListings.Count > 0)
    {
        <section class="just-listed">
            <div class="container">
                <div class="section-head">
                    <div class="eyebrow dark">
                        <span class="material-symbols-outlined" style="font-size:16px;">new_releases</span>
                        <span>Live on the marketplace</span>
                    </div>
                    <h2>Just listed</h2>
                    <p>The freshest goats for sale across every farm on GoatLab — updated minutes ago.</p>
                </div>
                <div class="just-listed-grid">
                    @foreach (var l in Model.RecentListings)
                    {
                        var hasPhoto = !string.IsNullOrEmpty(l.PrimaryPhotoUrl);
                        <a class="jl-card" href="@($"/pub/{l.FarmSlug}/{l.Id}")">
                            <div class="jl-photo @(hasPhoto ? "" : "empty")">
                                @if (hasPhoto)
                                {
                                    <img src="@l.PrimaryPhotoUrl" alt="@l.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span>🐐</span>
                                }
                                @if ((DateTime.UtcNow - l.ListedAt).TotalDays <= 3)
                                {
                                    <span class="jl-badge">Just listed</span>
                                }
                            </div>
                            <div class="jl-body">
                                <div class="jl-name">@l.Name</div>
                                <div class="jl-meta">@l.Gender@(string.IsNullOrEmpty(l.Breed) ? "" : $" · {l.Breed}")</div>
                                <div class="jl-farm">@l.FarmName@(string.IsNullOrEmpty(l.FarmLocation) ? "" : $" · {l.FarmLocation}")</div>
                                <div class="jl-bottom">
                                    @if (l.AskingPriceCents.HasValue)
                                    {
                                        <span class="jl-price">$@((l.AskingPriceCents.Value / 100m).ToString("N0"))</span>
                                    }
                                    else
                                    {
                                        <span class="jl-price-na">Inquire</span>
                                    }
                                    <span class="jl-listed">@ListedAgo(l.ListedAt)</span>
                                </div>
                            </div>
                        </a>
                    }
                </div>
                <div class="just-listed-cta">
                    <a href="/marketplace" class="btn btn-outlined">Browse the full marketplace <span class="material-symbols-outlined">arrow_forward</span></a>
                </div>
            </div>
        </section>
    }

    @* ---------- FEATURES ---------- *@
    <section class="features" id="features">
        <div class="container">
            <div class="section-head">
                <div class="eyebrow dark">
                    <span class="material-symbols-outlined" style="font-size:16px;">dashboard</span>
                    <span>Everything in one place</span>
                </div>
                <h2>Run the farm. Skip the spreadsheets.</h2>
                <p>GoatLab replaces the notebook on the barn wall, the breeding chart in the kitchen, and
                   the sales receipts in the glovebox — with one app that works online or off.</p>
            </div>

            <div class="feature-grid">
                @foreach (var f in features)
                {
                    <div class="feature-card">
                        <div class="feature-icon" style="background:@f.Bg;color:@f.Fg;">
                            <span class="material-symbols-outlined" style="font-size:28px;">@f.Symbol</span>
                        </div>
                        <h3>@f.Title</h3>
                        <p>@f.Body</p>
                    </div>
                }
            </div>
        </div>
    </section>

    @* ---------- NETWORK ADVANTAGES ---------- *@
    <section class="network" id="network">
        <div class="container">
            <div class="section-head">
                <div class="eyebrow dark">
                    <span class="material-symbols-outlined" style="font-size:16px;">hub</span>
                    <span>Built like a network, not just a tool</span>
                </div>
                <h2>The advantages no single-farm app can match.</h2>
                <p>
                    Most goat software locks your data inside one farm's account. GoatLab is multi-tenant
                    from day one — which means your records can connect, transfer, and verify across every
                    farm on the platform. Things that aren't possible without a network become possible.
                </p>
            </div>

            <div class="network-grid">
                <div class="network-card">
                    <div class="network-icon" style="background:rgba(46,125,50,0.12);color:#2e7d32;">
                        <span class="material-symbols-outlined" style="font-size:30px;">account_tree</span>
                    </div>
                    <h3>Cross-farm lineage</h3>
                    <p>
                        Click any goat's pedigree and walk backwards across farms. Ancestors on other public
                        GoatLab farms link directly to their own lineage page — verifiable provenance,
                        indexable by Google. The closest thing the goat world has to a Carfax.
                    </p>
                    <a href="/breeds" class="network-link">Browse the directory →</a>
                </div>
                <div class="network-card">
                    <div class="network-icon" style="background:rgba(63,81,181,0.12);color:#3f51b5;">
                        <span class="material-symbols-outlined" style="font-size:30px;">swap_horiz</span>
                    </div>
                    <h3>Farm-to-farm transfers</h3>
                    <p>
                        When two GoatLab farms transact, the animal carries its full history with it.
                        Pedigree, medical, weights, milk, photos — all move to the buyer's herd in one click.
                        No re-keying, no broken paperwork trail. Your records become more valuable the more
                        farms join.
                    </p>
                </div>
                <div class="network-card">
                    <div class="network-icon" style="background:rgba(229,57,53,0.12);color:#c62828;">
                        <span class="material-symbols-outlined" style="font-size:30px;">medical_services</span>
                    </div>
                    <h3>Vet share-links</h3>
                    <p>
                        Generate a one-time URL and text it to your vet. They open it on their phone — no
                        app install, no signup — see the full medical history, and leave a note that lands
                        on your goat's timeline. Vets stay vets; their notes become your records.
                    </p>
                </div>
                <div class="network-card">
                    <div class="network-icon" style="background:rgba(46,125,50,0.12);color:#2e7d32;">
                        <span class="material-symbols-outlined" style="font-size:30px;">storefront</span>
                    </div>
                    <h3>Public marketplace + Stripe deposits</h3>
                    <p>
                        List a goat for sale and it appears on Google in hours, not weeks. Buyers can
                        filter by breed/sex/price/state, follow your farm to be notified when you list, and
                        reserve with a refundable deposit via Stripe Checkout — locked into your waitlist
                        automatically.
                    </p>
                    <a href="/breeds" class="network-link">See active listings →</a>
                </div>
            </div>
        </div>
    </section>

    @* ---------- WORKFLOW ---------- *@
    <section class="workflow" id="workflow">
        <div class="container">
            <div class="section-head">
                <div class="eyebrow">
                    <span class="material-symbols-outlined" style="font-size:16px;">route</span>
                    <span>How it works</span>
                </div>
                <h2>Set up in minutes. Useful on day one.</h2>
            </div>

            <div class="steps">
                <div class="step">
                    <div class="step-num">1</div>
                    <h3>Create your farm</h3>
                    <p>Sign up and name your operation. Invite helpers later with their own roles.</p>
                </div>
                <div class="step">
                    <div class="step-num">2</div>
                    <h3>Add your herd</h3>
                    <p>Enter goats one by one, or import a CSV (or an ADGA/AGS registry export). Lineage links automatically by registration number.</p>
                </div>
                <div class="step">
                    <div class="step-num">3</div>
                    <h3>Log what happens</h3>
                    <p>Milkings, vet visits, breedings, sales. From your phone in the barn, even offline. Smart alerts catch what you forget.</p>
                </div>
                <div class="step">
                    <div class="step-num">4</div>
                    <h3>Go public when ready</h3>
                    <p>Flip on your public farm page, list goats for sale, and buyers find you on the marketplace. Reservations come in with Stripe deposits attached.</p>
                </div>
                <div class="step">
                    <div class="step-num">5</div>
                    <h3>See the whole picture</h3>
                    <p>Reports, forecasts, COI calculations, mate recommendations — so you can act, not guess.</p>
                </div>
            </div>
        </div>
    </section>

    @* ---------- COMPARISON ---------- *@
    <section class="compare" id="compare">
        <div class="container">
            <div class="section-head">
                <div class="eyebrow dark">
                    <span class="material-symbols-outlined" style="font-size:16px;">compare_arrows</span>
                    <span>vs. the alternatives</span>
                </div>
                <h2>Spreadsheets, generic herd apps, or Facebook groups?</h2>
                <p>Most goat farms juggle three tools today. GoatLab is one tool that does all three jobs — and a few more.</p>
            </div>

            <div class="compare-table-wrap">
                <table class="compare-table">
                    <thead>
                        <tr>
                            <th>Capability</th>
                            <th class="us">GoatLab</th>
                            <th>Spreadsheets</th>
                            <th>Generic herd app</th>
                            <th>Facebook&nbsp;group</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr><td>Goat records (health, breeding, milk, finance)</td><td class="us">✅</td><td>⚠️ DIY</td><td>✅</td><td>❌</td></tr>
                        <tr><td>Public farm page with goats for sale</td><td class="us">✅</td><td>❌</td><td>❌</td><td>⚠️ posts only</td></tr>
                        <tr><td>Cross-farm marketplace at <code>/marketplace</code></td><td class="us">✅</td><td>❌</td><td>❌</td><td>⚠️ scrolling timeline</td></tr>
                        <tr><td>Pedigree that walks across farms</td><td class="us">✅</td><td>❌</td><td>❌ trapped per-farm</td><td>❌</td></tr>
                        <tr><td>Stripe deposits direct from listing</td><td class="us">✅</td><td>❌</td><td>❌</td><td>❌</td></tr>
                        <tr><td>Buyer messaging in one inbox</td><td class="us">✅</td><td>❌</td><td>❌</td><td>⚠️ DM chaos</td></tr>
                        <tr><td>Goat transfer carries the full record</td><td class="us">✅</td><td>❌</td><td>❌</td><td>❌</td></tr>
                        <tr><td>Vet share-link without a login</td><td class="us">✅</td><td>❌</td><td>⚠️ varies</td><td>❌</td></tr>
                        <tr><td>Works offline in the barn (PWA)</td><td class="us">✅</td><td>⚠️ if local</td><td>⚠️ varies</td><td>❌</td></tr>
                        <tr><td>Open source, self-host on your hardware</td><td class="us">✅</td><td>—</td><td>❌</td><td>❌</td></tr>
                        <tr><td>Free tier that's actually useful</td><td class="us">✅ Homestead</td><td>✅ free</td><td>⚠️ varies</td><td>✅ free</td></tr>
                    </tbody>
                </table>
            </div>

            <p class="compare-footnote">
                ✅ = built-in &nbsp; ⚠️ = partial / depends on you &nbsp; ❌ = not available &nbsp; — = not applicable.
                We don't list specific competitor prices because they change — focus on what each tool actually does for your farm.
            </p>
        </div>
    </section>

    @* ---------- PRICING ---------- *@
    <section class="pricing" id="pricing">
        <div class="container">
            <div class="section-head">
                <div class="eyebrow dark">
                    <span class="material-symbols-outlined" style="font-size:16px;">local_offer</span>
                    <span>Simple, honest pricing</span>
                </div>
                <h2>Start free. Grow when you're ready.</h2>
            </div>

            <div class="plan-grid">
                @if (Model.Plans.Count == 0)
                {
                    <div class="plans-error">
                        <p>Pricing details are temporarily unavailable. Try refreshing the page, or
                        <a href="/register">start free</a> and pick a plan from inside the app.</p>
                    </div>
                }
                else
                {
                    @for (var i = 0; i < Model.Plans.Count; i++)
                    {
                        var plan = Model.Plans[i];
                        var featured = Model.Plans.Count > 1 && i == Model.Plans.Count / 2;
                        <div class="plan @(featured ? "featured" : "")">
                            @if (featured)
                            {
                                <div class="plan-badge">Most popular</div>
                            }
                            <div class="plan-name">@plan.Name</div>
                            <div class="plan-price">
                                @(plan.PriceMonthlyCents == 0 ? "Free" : $"${plan.PriceMonthlyCents / 100m:0}")
                                <span>@(plan.PriceMonthlyCents == 0 ? "forever" : "/ month")</span>
                            </div>
                            @if (!string.IsNullOrEmpty(plan.Description))
                            {
                                <div class="plan-line">@plan.Description</div>
                            }
                            <ul>
                                <li><span class="material-symbols-outlined">check</span> @(plan.MaxGoats?.ToString() ?? "Unlimited") goats</li>
                                <li><span class="material-symbols-outlined">check</span> @(plan.MaxUsers?.ToString() ?? "Unlimited") users</li>
                                @foreach (var f in plan.Features)
                                {
                                    <li><span class="material-symbols-outlined">check</span> @f</li>
                                }
                            </ul>
                            <a href="/register" class="btn @(featured ? "btn-filled" : "btn-outlined")" style="width:100%;">@CtaLabel(plan)</a>
                        </div>
                    }
                }
            </div>
        </div>
    </section>

    @* ---------- SELF-HOST / DOCKER ---------- *@
