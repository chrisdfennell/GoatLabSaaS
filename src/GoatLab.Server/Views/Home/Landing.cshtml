    @* Terminal Docker Hub / From source tab toggle — the only interactive bit
       on the page, kept as a few lines of vanilla JS (matches the SSR pattern
       used by /pub and /breeds). *@
    <script>
        (function () {
            var tabs = document.querySelectorAll('.term-tab');
            var panels = document.querySelectorAll('.term-body[data-panel]');
            tabs.forEach(function (tab) {
                tab.addEventListener('click', function () {
                    var target = tab.getAttribute('data-tab');
                    tabs.forEach(function (t) {
                        var on = t === tab;
                        t.classList.toggle('active', on);
                        t.setAttribute('aria-selected', on ? 'true' : 'false');
                    });
                    panels.forEach(function (p) {
                        p.style.display = p.getAttribute('data-panel') === target ? '' : 'none';
                    });
                });
            });
        })();
    </script>

</body>
