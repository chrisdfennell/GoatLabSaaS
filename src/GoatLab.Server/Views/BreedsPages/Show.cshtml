@using GoatLab.Server.Controllers
@using GoatLab.Shared.DTOs
@model IReadOnlyList<BreedsPagesController.MarketplaceListing>
@{
    var displayName = ViewData["DisplayName"] as string ?? "Breed";
    var slug = ViewData["BreedSlug"] as string ?? "";
    var farms = (ViewData["Farms"] as IReadOnlyList<BreedFarmDto>) ?? Array.Empty<BreedFarmDto>();
    var totalListings = (int)(ViewData["TotalListings"] ?? 0);
    var sex = ViewData["FilterSex"] as string;
    var maxPrice = ViewData["FilterMaxPrice"] as int?;
    var minPrice = ViewData["FilterMinPrice"] as int?;
    var stateFilter = ViewData["FilterState"] as string;
    var sortVal = ViewData["FilterSort"] as string;

    ViewData["Title"] = $"{displayName} goats for sale — GoatLab marketplace";
    ViewData["Description"] = $"Browse {Model.Count} {displayName} listings across {farms.Count} GoatLab farms. Filter by sex, price, and state. Contact sellers directly or reserve with a Stripe deposit.";

    var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
    ViewData["Canonical"] = $"{origin}/breeds/{slug}";

    // JSON-LD: ItemList of Product listings (the goats themselves) plus a
    // sub-list of breeders. Google can use either as the rich-result anchor.
    var products = string.Join(",", Model.Take(20).Select((g, i) => $@"{{
      ""@type"": ""ListItem"",
      ""position"": {i + 1},
      ""item"": {{
        ""@type"": ""Product"",
        ""name"": ""{System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(g.Name)}"",
        ""url"": ""{origin}/pub/{g.FarmSlug}/{g.Id}"",
        ""category"": ""{System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(g.Breed ?? displayName)}""
        {(g.AskingPriceCents.HasValue ? $@",""offers"": {{ ""@type"": ""Offer"", ""price"": ""{(g.AskingPriceCents.Value / 100m):0.00}"", ""priceCurrency"": ""USD"", ""availability"": ""https://schema.org/InStock"" }}" : "")}
      }}
    }}"));
    ViewData["JsonLd"] = $@"{{
  ""@context"": ""https://schema.org"",
  ""@type"": ""CollectionPage"",
  ""name"": ""{System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(displayName)} goats for sale"",
  ""description"": ""{ViewData["Description"]}"",
  ""url"": ""{ViewData["Canonical"]}"",
  ""mainEntity"": {{
    ""@type"": ""ItemList"",
    ""numberOfItems"": {Model.Count},
    ""itemListElement"": [{products}]
  }}
}}";

    string AgeString(DateTime? dob)
    {
        if (!dob.HasValue) return "";
        var months = (int)((DateTime.UtcNow - dob.Value).TotalDays / 30.44);
        if (months < 12) return months + " mo";
        var y = months / 12; var m = months % 12;
        return m == 0 ? y + " yr" : $"{y} yr {m} mo";
    }

    string ListedAgo(DateTime? listedAt)
    {
        if (!listedAt.HasValue) return "";
        var diff = DateTime.UtcNow - listedAt.Value;
        if (diff.TotalDays < 1) return "Listed today";
        if (diff.TotalDays < 2) return "Listed yesterday";
        if (diff.TotalDays < 30) return $"Listed {(int)diff.TotalDays}d ago";
        if (diff.TotalDays < 365) return $"Listed {(int)(diff.TotalDays / 30)}mo ago";
        return $"Listed {(int)(diff.TotalDays / 365)}y ago";
    }
}

<div class="breadcrumbs">
    <a href="/breeds">Breeds</a>
    <span class="sep">›</span>
    <span>@displayName</span>
</div>

<div class="eyebrow">@displayName marketplace</div>
<h1>@displayName goats for sale</h1>
<p class="lede">
    @totalListings active @(totalListings == 1 ? "listing" : "listings") across @farms.Count
    @(farms.Count == 1 ? "farm" : "farms"). Filter and sort to find the right animal — or
    <a href="#farms">browse breeders</a> directly.
</p>

<form method="get" class="filter-bar" action="/breeds/@slug">
    <div class="filter-field">
        <label>Sex</label>
        <select name="sex">
            <option value="">Any</option>
            <option value="Female" selected="@(sex == "Female")">Doe</option>
            <option value="Male" selected="@(sex == "Male")">Buck</option>
            <option value="Wether" selected="@(sex == "Wether")">Wether</option>
        </select>
    </div>
    <div class="filter-field">
        <label>Min price ($)</label>
        <input type="number" name="minPrice" min="0" step="50" value="@(minPrice?.ToString() ?? "")" placeholder="0" />
    </div>
    <div class="filter-field">
        <label>Max price ($)</label>
        <input type="number" name="maxPrice" min="0" step="50" value="@(maxPrice?.ToString() ?? "")" placeholder="any" />
    </div>
    <div class="filter-field">
        <label>State / region</label>
        <input type="text" name="state" value="@stateFilter" placeholder="e.g. Texas" maxlength="50" />
    </div>
    <div class="filter-field">
        <label>Sort</label>
        <select name="sort">
            <option value="" selected="@(string.IsNullOrEmpty(sortVal))">Lowest price</option>
            <option value="price-desc" selected="@(sortVal == "price-desc")">Highest price</option>
            <option value="newest" selected="@(sortVal == "newest")">Newest</option>
        </select>
    </div>
    <div class="filter-actions">
        <button type="submit" class="cta-button">Apply</button>
        @if (sex is not null || minPrice.HasValue || maxPrice.HasValue || !string.IsNullOrEmpty(stateFilter) || !string.IsNullOrEmpty(sortVal))
        {
            <a href="/breeds/@slug" class="filter-clear">Clear</a>
        }
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="icon">🔍</div>
        <h2 style="margin: 4px 0;">No matching @displayName listings.</h2>
        <p style="margin: 4px 0;">Try widening your filters, or <a href="/breeds/@slug">clear them</a> to see all @totalListings @displayName listings.</p>
    </div>
}
else
{
    <div class="goats-grid" style="margin-top: 24px;">
        @foreach (var g in Model)
        {
            <a class="goat-card" href="/pub/@g.FarmSlug/@g.Id">
                <div class="goat-card-photo @(string.IsNullOrEmpty(g.PrimaryPhotoUrl) ? "empty" : "")">
                    @if (g.PhotoUrls is { Count: > 0 })
                    {
                        <div class="carousel-track">
                            @for (var pi = 0; pi < g.PhotoUrls.Count; pi++)
                            {
                                <img src="@g.PhotoUrls[pi]" alt="@g.Name @(pi + 1)"
                                     class="@(pi == 0 ? "active" : "")"
                                     loading="lazy" />
                            }
                        </div>
                        @if (g.PhotoUrls.Count > 1)
                        {
                            <button type="button" class="carousel-nav prev" aria-label="Previous photo"
                                    onclick="event.preventDefault();event.stopPropagation();window.goatlabCarousel.step(this,-1);">‹</button>
                            <button type="button" class="carousel-nav next" aria-label="Next photo"
                                    onclick="event.preventDefault();event.stopPropagation();window.goatlabCarousel.step(this,1);">›</button>
                            <div class="carousel-dots">
                                @for (var pi = 0; pi < g.PhotoUrls.Count; pi++)
                                {
                                    <span class="@(pi == 0 ? "active" : "")"></span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <span>🐐</span>
                    }
                    @if (g.ListedAt.HasValue && (DateTime.UtcNow - g.ListedAt.Value).TotalDays <= 3)
                    {
                        <span class="badge-fresh">Just listed</span>
                    }
                </div>
                <div class="goat-card-body">
                    <div class="goat-card-name">@g.Name</div>
                    <div class="goat-card-meta">
                        @g.Gender@(g.DateOfBirth.HasValue ? $" · {AgeString(g.DateOfBirth)}" : "")
                    </div>
                    <div class="goat-card-farm">@g.FarmName@(string.IsNullOrEmpty(g.FarmLocation) ? "" : $" · {g.FarmLocation}")</div>
                    <div class="goat-card-bottom">
                        @if (g.AskingPriceCents.HasValue)
                        {
                            <div class="goat-card-price">$@((g.AskingPriceCents.Value / 100m).ToString("N0"))</div>
                        }
                        @if (g.ListedAt.HasValue)
                        {
                            <div class="goat-card-listed">@ListedAgo(g.ListedAt)</div>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
}

@* Saved-search subscribe — appears below the listings grid so it's visible
   after a buyer has scanned current results. The form pre-fills with whatever
   filters are currently in the URL so subscribing matches the active view. *@
<section class="alert-subscribe">
    <div class="alert-subscribe-icon">🔔</div>
    <div class="alert-subscribe-body">
        <h3 style="margin:0 0 4px 0;">Get notified about new @displayName listings</h3>
        <p style="margin:0 0 12px 0;color:#4a5a51;font-size:0.95rem;">
            Drop your email and we'll send one notification when a new @displayName matching your filters
            appears anywhere on GoatLab. Unsubscribe in one click.
        </p>
        <form id="alert-form" class="alert-form"
              data-breed="@slug"
              data-sex="@sex"
              data-min="@(minPrice?.ToString() ?? "")"
              data-max="@(maxPrice?.ToString() ?? "")"
              data-state="@stateFilter">
            <input type="email" name="email" placeholder="you@example.com" required autocomplete="email"
                   aria-label="Your email address" />
            <button type="submit">Save search</button>
        </form>
        <div id="alert-status" class="alert-status" role="status"></div>
    </div>
</section>

@if (farms.Count > 0)
{
    <h2 id="farms" style="margin-top: 48px;">@displayName breeders</h2>
    <p class="lede" style="margin-top: 4px;">Visit a farm to see their full herd or contact them directly.</p>
    <div class="farms-grid">
        @foreach (var f in farms)
        {
            <a class="farm-card" href="/pub/@f.FarmSlug">
                @if (!string.IsNullOrEmpty(f.HeroPhotoUrl))
                {
                    <div class="photo"><img src="@f.HeroPhotoUrl" alt="@f.FarmName" loading="lazy" /></div>
                }
                else
                {
                    <div class="photo empty">🐐</div>
                }
                <div class="body">
                    <h3 class="name">@f.FarmName</h3>
                    @if (!string.IsNullOrEmpty(f.Location))
                    {
                        <div class="location">📍 @f.Location</div>
                    }
                    <div class="footer">
                        <span class="chip">@f.ListingCount @displayName</span>
                        @if (f.StartingPriceCents.HasValue)
                        {
                            <span class="price">from $@((f.StartingPriceCents.Value / 100m).ToString("N0"))</span>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
}

<style>
    .filter-bar {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 12px;
        align-items: end;
        margin-top: 16px;
        padding: 16px;
        background: #f7f8f7;
        border: 1px solid #e3e8e4;
        border-radius: 10px;
    }
    .filter-field { display: flex; flex-direction: column; }
    .filter-field label { font-size: 12px; color: #4a5a51; font-weight: 600; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
    .filter-field input, .filter-field select { padding: 8px 10px; border: 1px solid #ccc; border-radius: 6px; font-size: 14px; font-family: inherit; background: #fff; }
    .filter-field input:focus, .filter-field select:focus { outline: none; border-color: #2e7d32; box-shadow: 0 0 0 2px rgba(46,125,50,0.15); }
    .filter-actions { display: flex; align-items: center; gap: 10px; }
    .filter-clear { font-size: 13px; color: #6b7a70; }

    .goats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 16px;
    }
    .goat-card {
        display: block;
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .goat-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.08); text-decoration: none; }
    .goat-card-photo { aspect-ratio: 4 / 3; background: #f5f5f5; position: relative; overflow: hidden; }
    .goat-card-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .goat-card-photo.empty { display: flex; align-items: center; justify-content: center; font-size: 3rem; color: #bbb; }
    .carousel-track { position: absolute; inset: 0; }
    .carousel-track img { position: absolute; inset: 0; opacity: 0; transition: opacity 0.2s ease; }
    .carousel-track img.active { opacity: 1; }
    .carousel-nav {
        position: absolute; top: 50%; transform: translateY(-50%);
        width: 30px; height: 30px;
        background: rgba(255,255,255,0.85); border: 0; border-radius: 50%;
        font-size: 1.15rem; font-weight: 700; color: #1b5e20; cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        opacity: 0; transition: opacity 0.15s ease; z-index: 2;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    .carousel-nav.prev { left: 6px; } .carousel-nav.next { right: 6px; }
    .goat-card-photo:hover .carousel-nav { opacity: 1; }
    .carousel-dots {
        position: absolute; bottom: 6px; left: 0; right: 0;
        display: flex; justify-content: center; gap: 4px; z-index: 2;
    }
    .carousel-dots span {
        width: 5px; height: 5px;
        background: rgba(255,255,255,0.6); border-radius: 50%;
    }
    .carousel-dots span.active { background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,0.15); }
    .badge-fresh {
        position: absolute; top: 8px; left: 8px;
        background: #2e7d32; color: #fff;
        font-size: 0.72rem; font-weight: 700;
        padding: 3px 8px; border-radius: 999px;
        letter-spacing: 0.3px; text-transform: uppercase;
        box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }
    .goat-card-body { padding: 12px 14px; }
    .goat-card-name { font-weight: 700; font-size: 1.05rem; }
    .goat-card-meta { font-size: 0.85rem; color: #6b7a70; margin-top: 2px; }
    .goat-card-farm { font-size: 0.82rem; color: #4a5a51; margin-top: 4px; }
    .goat-card-bottom { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; margin-top: 6px; }
    .goat-card-price { color: #2e7d32; font-weight: 700; font-size: 1.05rem; }
    .goat-card-listed { font-size: 0.72rem; color: #6b7a70; white-space: nowrap; }

    .alert-subscribe {
        display: flex; gap: 16px; margin-top: 36px; padding: 18px 20px;
        background: #fff; border: 1px solid #e0e0e0; border-radius: 10px;
        align-items: flex-start;
    }
    .alert-subscribe-icon { font-size: 32px; line-height: 1; }
    .alert-subscribe-body { flex: 1; min-width: 0; }
    .alert-form { display: flex; gap: 8px; flex-wrap: wrap; }
    .alert-form input { flex: 1; min-width: 200px; padding: 10px 12px; border: 1px solid #ccc; border-radius: 8px; font-size: 14px; font-family: inherit; }
    .alert-form input:focus { outline: none; border-color: #2e7d32; box-shadow: 0 0 0 2px rgba(46,125,50,0.15); }
    .alert-form button { padding: 10px 18px; background: #2e7d32; color: #fff; border: 0; border-radius: 8px; font-size: 14px; font-weight: 600; cursor: pointer; }
    .alert-form button:hover { background: #1b5e20; }
    .alert-form button:disabled { opacity: 0.6; cursor: not-allowed; }
    .alert-status { font-size: 0.88rem; margin-top: 8px; min-height: 1.2em; }
    .alert-status.success { color: #1b5e20; }
    .alert-status.error { color: #c62828; }
</style>

<script>
    (function () {
        var form = document.getElementById('alert-form');
        var status = document.getElementById('alert-status');
        if (!form) return;
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            var input = form.querySelector('input[name="email"]');
            var btn = form.querySelector('button');
            if (!input || !btn) return;
            var email = (input.value || '').trim();
            if (!email) return;
            btn.disabled = true; btn.textContent = '…';
            status.textContent = '';
            status.className = 'alert-status';
            var d = form.dataset;
            try {
                var headers = { 'Content-Type': 'application/json' };
                if (window.goatlabRecaptcha) {
                    var token = await window.goatlabRecaptcha.execute('marketplace_alert');
                    if (token) headers['X-Recaptcha-Token'] = token;
                }
                var resp = await fetch('/api/marketplace/alerts', {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify({
                        email: email,
                        breedSlug: d.breed || null,
                        sex: d.sex || null,
                        minPriceCents: d.min ? parseInt(d.min, 10) * 100 : null,
                        maxPriceCents: d.max ? parseInt(d.max, 10) * 100 : null,
                        state: d.state || null,
                    })
                });
                var data = await resp.json().catch(function () { return null; });
                if (resp.ok && data && data.ok) {
                    status.textContent = data.message || "Saved! Check your email to confirm.";
                    status.className = 'alert-status success';
                    input.value = '';
                } else {
                    status.textContent = (data && data.message) || 'Something went wrong. Try again in a moment.';
                    status.className = 'alert-status error';
                }
            } catch (err) {
                status.textContent = 'Network error — please try again.';
                status.className = 'alert-status error';
            } finally {
                btn.disabled = false; btn.textContent = 'Save search';
            }
        });
    })();
</script>
