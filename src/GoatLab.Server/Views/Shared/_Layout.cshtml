@inject Microsoft.Extensions.Configuration.IConfiguration AppConfig
@{
    var title = ViewData["Title"] as string ?? "GoatLab";
    var description = ViewData["Description"] as string ?? "GoatLab — goat herd management for homesteaders and dairy farms.";
    var canonical = ViewData["Canonical"] as string ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var ogImage = ViewData["OgImage"] as string;
    var jsonLd = ViewData["JsonLd"] as string;
    var recaptchaSiteKey = AppConfig["Recaptcha:SiteKey"] ?? string.Empty;
    var robots = ViewData["Robots"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@description" />
    @if (!string.IsNullOrEmpty(robots))
    {
        <meta name="robots" content="@robots" />
    }
    <link rel="canonical" href="@canonical" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    @if (!string.IsNullOrEmpty(ogImage))
    {
        <meta property="og:image" content="@ogImage" />
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />

    <link rel="icon" href="/favicon.png" type="image/png" />

    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: #1a2421;
            background: #fff;
            line-height: 1.5;
        }
        a { color: #2e7d32; text-decoration: none; }
        a:hover { text-decoration: underline; }
        header.site-header {
            background: #fff;
            border-bottom: 1px solid #e0e0e0;
            padding: 14px 0;
            position: sticky;
            top: 0;
            z-index: 10;
        }
        header.site-header .inner {
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        header.site-header .brand {
            font-weight: 800;
            font-size: 1.25rem;
            color: #1b5e20;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        header.site-header nav {
            display: flex; align-items: center; gap: 20px;
        }
        header.site-header nav a {
            font-weight: 500;
            color: #1a2421;
            white-space: nowrap;
        }
        /* Mobile: compress so Sign in + Start free stay on the top bar
           instead of wrapping to a second line. The "Breeds" link is hidden
           below 540px since the user is usually already on a public page. */
        @@media (max-width: 600px) {
            header.site-header { padding: 10px 0; }
            header.site-header .inner { padding: 0 12px; }
            header.site-header nav { gap: 10px; }
            header.site-header nav a { font-size: 14px; }
            .cta-button { padding: 8px 12px; font-size: 14px; }
        }
        @@media (max-width: 540px) {
            header.site-header nav a[href="/breeds"] { display: none; }
        }
        .cta-button {
            display: inline-block;
            background: #2e7d32;
            color: #fff !important;
            padding: 10px 18px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
        }
        .cta-button:hover { background: #1b5e20; text-decoration: none; }

        main {
            max-width: 1100px;
            margin: 0 auto;
            padding: 32px 20px 48px;
            animation: page-fade-in 220ms ease-out both;
        }
        @@keyframes page-fade-in {
            from { opacity: 0; transform: translateY(6px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        @@media (prefers-reduced-motion: reduce) {
            main { animation: none; }
        }
        /* Polished focus ring for keyboard nav — visible on every interactive
           element without overriding their visual style. */
        a:focus-visible, button:focus-visible, input:focus-visible,
        textarea:focus-visible, select:focus-visible, [tabindex]:focus-visible {
            outline: 2px solid #2e7d32;
            outline-offset: 2px;
            border-radius: 4px;
        }
        /* Smooth in-page anchor jumps (e.g. landing nav → #features). */
        html { scroll-behavior: smooth; }
        @@media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
        }
        h1 { font-size: 2.25rem; font-weight: 800; margin: 0 0 12px 0; color: #1a2421; }
        h2 { font-size: 1.5rem; font-weight: 700; }
        .eyebrow { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 2px; color: #2e7d32; font-weight: 600; }
        .lede { font-size: 1.05rem; color: #4a5a51; margin-bottom: 28px; }

        footer.site-footer {
            border-top: 1px solid #e0e0e0;
            padding: 24px 20px;
            text-align: center;
            color: #6b7a70;
            font-size: 0.9rem;
        }
        footer.site-footer a { color: #6b7a70; margin: 0 8px; }

        .breeds-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 12px;
        }
        .breed-card {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 16px;
            background: #fff;
            border: 1px solid #e0e0e0;
            border-radius: 10px;
            text-decoration: none;
            color: inherit;
            transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
        }
        .breed-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(46,125,50,0.12);
            border-color: #2e7d32;
            text-decoration: none;
        }
        .breed-card .icon { font-size: 2.2rem; line-height: 1; }
        .breed-card .body { flex: 1; min-width: 0; }
        .breed-card .name { font-weight: 700; font-size: 1.1rem; color: #1a2421; }
        .breed-card .meta { font-size: 0.88rem; color: #6b7a70; margin-top: 2px; }
        .breed-card .arrow { color: #999; font-size: 1.2rem; }

        .breadcrumbs {
            font-size: 0.85rem;
            color: #6b7a70;
            margin-bottom: 12px;
        }
        .breadcrumbs a { color: #6b7a70; }
        .breadcrumbs .sep { margin: 0 6px; color: #ccc; }

        .farms-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 16px;
            margin-top: 16px;
        }
        .farm-card {
            display: block;
            text-decoration: none;
            color: inherit;
            background: #fff;
            border: 1px solid #e0e0e0;
            border-radius: 10px;
            overflow: hidden;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .farm-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.08);
            text-decoration: none;
        }
        .farm-card .photo {
            aspect-ratio: 16 / 9;
            background: #f5f5f5;
            overflow: hidden;
        }
        .farm-card .photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .farm-card .photo.empty {
            display: flex;
            align-items: center;
            justify-content: center;
            color: #bbb;
            font-size: 3rem;
        }
        .farm-card .body { padding: 14px; }
        .farm-card .name { font-weight: 700; font-size: 1.1rem; margin: 0; }
        .farm-card .location { font-size: 0.88rem; color: #6b7a70; margin-top: 2px; }
        .farm-card .footer {
            margin-top: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .chip {
            display: inline-block;
            padding: 3px 10px;
            border: 1px solid #2e7d32;
            color: #2e7d32;
            border-radius: 12px;
            font-size: 0.78rem;
            font-weight: 600;
        }
        .price {
            color: #2e7d32;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .empty-state {
            text-align: center;
            padding: 48px 20px;
            border: 1px dashed #ccc;
            border-radius: 10px;
            color: #6b7a70;
        }
        .empty-state .icon { font-size: 3rem; color: #bbb; margin-bottom: 8px; }
    </style>

    @if (!string.IsNullOrEmpty(jsonLd))
    {
        @Html.Raw($"<script type=\"application/ld+json\">{jsonLd}</script>")
    }

    @if (!string.IsNullOrEmpty(recaptchaSiteKey))
    {
        <script src="https://www.google.com/recaptcha/api.js?render=@recaptchaSiteKey" async defer></script>
        <script>
            // Global reCAPTCHA helper for SSR pages. Mirrors the Blazor side
            // so call sites can do: const t = await goatlabRecaptcha.execute('action').
            // For <form> posts, also intercepts submission and injects a hidden
            // g-recaptcha-response input that the server-side filter falls back to.
            (function () {
                var siteKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(recaptchaSiteKey));
                window.goatlabRecaptcha = {
                    execute: function (action) {
                        return new Promise(function (resolve) {
                            if (typeof grecaptcha === 'undefined') { resolve(null); return; }
                            grecaptcha.ready(function () {
                                grecaptcha.execute(siteKey, { action: action })
                                    .then(function (t) { resolve(t); })
                                    .catch(function () { resolve(null); });
                            });
                        });
                    }
                };

                // Auto-wire any <form data-recaptcha-action="X"> on the page —
                // intercept submit, fetch a token, append a hidden input, then
                // continue submission. Lets SSR HTML forms participate without
                // every page writing its own JS.
                document.addEventListener('DOMContentLoaded', function () {
                    var forms = document.querySelectorAll('form[data-recaptcha-action]');
                    forms.forEach(function (form) {
                        form.addEventListener('submit', function (e) {
                            if (form.dataset.recaptchaSubmitted === '1') return;
                            e.preventDefault();
                            // Set the flag synchronously so a second click before the
                            // token resolves can't kick off a parallel submission.
                            form.dataset.recaptchaSubmitted = '1';
                            var action = form.getAttribute('data-recaptcha-action') || 'submit';
                            window.goatlabRecaptcha.execute(action).then(function (token) {
                                if (token) {
                                    var input = form.querySelector('input[name="g-recaptcha-response"]');
                                    if (!input) {
                                        input = document.createElement('input');
                                        input.type = 'hidden';
                                        input.name = 'g-recaptcha-response';
                                        form.appendChild(input);
                                    }
                                    input.value = token;
                                }
                                form.submit();
                            });
                        });
                    });
                });
            })();
        </script>
    }
</head>
<body>
    <header class="site-header">
        <div class="inner">
            <a href="/" class="brand">
                <span>🐐</span>
                <span>GoatLab</span>
            </a>
            <nav>
                <a href="/marketplace">For sale</a>
                <a href="/breeds">Breeds</a>
                <a href="/compare" id="nav-favs">Favorites</a>
                <a href="/buyer/dashboard" id="nav-my-account" style="display:none;">My account</a>
                <a href="/login">Sign in</a>
                <a href="/register" class="cta-button">Start free</a>
            </nav>
            <script>
                // Show "My account" only when the buyer cookie is set.
                (async function () {
                    try {
                        var resp = await fetch('/api/buyer/me');
                        if (resp.ok) {
                            var el = document.getElementById('nav-my-account');
                            if (el) el.style.display = '';
                        }
                    } catch (e) { /* ignore */ }
                })();
            </script>
            <script>
                // Show favorite count next to the nav link if any are saved.
                (function () {
                    try {
                        var n = (JSON.parse(localStorage.getItem('goatlab.favorites') || '[]') || []).length;
                        var el = document.getElementById('nav-favs');
                        if (el && n > 0) el.textContent = 'Favorites (' + n + ')';
                    } catch { }
                })();
            </script>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    @* Buyer "Save listing" toggle — shared by /pub and /marketplace. Calls
       /api/buyer/saved to add/remove; if the user isn't signed in the API
       returns 401 and we redirect to the buyer sign-in page with a
       returnUrl pointing at the current page. State is reflected in the
       button class (.saved) and inner content. *@
    <script>
        (async function () {
            // On page load: (1) fetch my saved IDs to highlight matching
            // [data-goat-id] elements, (2) flush any "pending save" the
            // buyer queued before they signed in. The pending-save flow
            // makes the marketplace Save button work even when the buyer
            // is anonymous: anon click → store ID locally → magic-link
            // sign-in → return to the original URL → this code auto-fires
            // the save the buyer intended.

            // Skip the network round-trip on pages that have nothing to
            // highlight and no queued pending save (most public pages).
            var hasSaveables = document.querySelector('[data-goat-id]') !== null;
            var hasPending = false;
            try { hasPending = !!localStorage.getItem('goatlab.pendingSaveId'); } catch (e) { }
            if (!hasSaveables && !hasPending) return;

            try {
                var resp = await fetch('/api/buyer/saved');
                if (!resp.ok) return;
                var ids = await resp.json();
                var set = new Set((Array.isArray(ids) ? ids : []).map(String));

                // Flush a pending pre-signin save, if any. Validate the ID is
                // a positive integer before sending — junk entries shouldn't
                // hit the server.
                var pending = null;
                try { pending = localStorage.getItem('goatlab.pendingSaveId'); } catch (e) { }
                var pendingId = pending ? parseInt(pending, 10) : NaN;
                if (Number.isFinite(pendingId) && pendingId > 0 && !set.has(String(pendingId))) {
                    try {
                        var saveResp = await fetch('/api/buyer/saved', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ goatId: pendingId })
                        });
                        // Only mark as saved if the server actually accepted it,
                        // otherwise the UI lies about state.
                        if (saveResp.ok) {
                            set.add(String(pendingId));
                            try { localStorage.removeItem('goatlab.pendingSaveId'); } catch (e) { }
                        } else if (saveResp.status === 404 || saveResp.status === 400) {
                            // Goat is gone or the ID was bad — don't keep retrying.
                            try { localStorage.removeItem('goatlab.pendingSaveId'); } catch (e) { }
                        }
                    } catch (e) { /* network blip — leave pending for next load */ }
                } else if (pending) {
                    // Already saved or unparseable — drop it.
                    try { localStorage.removeItem('goatlab.pendingSaveId'); } catch (e) { }
                }

                if (set.size === 0) return;
                document.querySelectorAll('[data-goat-id]').forEach(function (el) {
                    if (set.has(String(el.dataset.goatId))) {
                        el.classList.add('saved');
                        applySaveLabel(el, true);
                    }
                });
            } catch (e) { /* swallow */ }
        })();

        function applySaveLabel(btn, saved) {
            if (btn.tagName !== 'BUTTON') return;
            // Icon-only buttons (cards) — leave the SVG alone.
            if (btn.querySelector('svg')) return;
            var savedLabel = btn.dataset.savedLabel || '⭐ Saved';
            var unsavedLabel = btn.dataset.saveLabel || '⭐ Save to my list';
            btn.innerHTML = saved ? savedLabel : unsavedLabel;
        }

        window.toggleSaveListing = async function (btn) {
            var id = btn.dataset.goatId;
            if (!id) return;
            var saved = btn.classList.contains('saved');
            var url = saved ? '/api/buyer/saved/' + encodeURIComponent(id) : '/api/buyer/saved';
            var opts = saved
                ? { method: 'DELETE' }
                : { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ goatId: parseInt(id, 10) }) };
            var resp = await fetch(url, opts);
            if (resp.status === 401) {
                // Stash the buyer's intent so the auto-flush above completes
                // the save after they finish the magic-link sign-in flow.
                try { localStorage.setItem('goatlab.pendingSaveId', String(id)); } catch (e) { }
                window.location = '/buyer/sign-in?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                return;
            }
            if (resp.ok) {
                btn.classList.toggle('saved', !saved);
                applySaveLabel(btn, !saved);
            }
        };
    </script>

    @* Card photo carousel — global helper so any SSR view rendering goat
       cards can use the same prev/next logic. Inline onclick attrs on the
       buttons call this rather than wiring per-card listeners. *@
    <script>
        window.goatlabCarousel = window.goatlabCarousel || {
            step: function (btn, dir) {
                var photo = btn.closest('.goat-card-photo');
                if (!photo) return;
                var imgs = photo.querySelectorAll('.carousel-track img');
                var dots = photo.querySelectorAll('.carousel-dots span');
                if (imgs.length < 2) return;
                var current = 0;
                for (var i = 0; i < imgs.length; i++) {
                    if (imgs[i].classList.contains('active')) { current = i; break; }
                }
                var next = (current + dir + imgs.length) % imgs.length;
                imgs[current].classList.remove('active');
                imgs[next].classList.add('active');
                if (dots[current]) dots[current].classList.remove('active');
                if (dots[next]) dots[next].classList.add('active');
            }
        };
    </script>

    <footer class="site-footer">
        <div>
            <a href="/">GoatLab</a>
            <a href="/breeds">Breeds</a>
            <a href="/terms">Terms</a>
            <a href="/privacy">Privacy</a>
        </div>
        <div style="margin-top: 8px; opacity: 0.7;">© @DateTime.UtcNow.Year GoatLab. Made for goat people.</div>
    </footer>
</body>
</html>
