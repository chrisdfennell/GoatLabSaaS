@{
    ViewData["Title"] = "Lineage not available — GoatLab";
    ViewData["Description"] = "This goat's lineage isn't publicly visible.";
}

<div class="empty-state" style="margin-top: 40px;">
    <div class="icon">🌳</div>
    <h1 style="margin: 8px 0;">This lineage isn't public</h1>
    <p>
        Lineage pages are visible only for goats currently for sale, with a tracked GoatLab transfer
        history, or with offspring listed by other GoatLab farms. The owner can list this goat to
        make their lineage publicly browseable.
    </p>
    <p>
        <a class="cta-button" href="/breeds">Browse breeders</a>
    </p>
</div>
