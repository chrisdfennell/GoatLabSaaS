@using GoatLab.Shared.DTOs
@using GoatLab.Server.Controllers
@model PublicGoatDto
@{
    var slug = (string?)ViewData["FarmSlug"] ?? Model.FarmSlug;
    var depositStatus = (string?)ViewData["DepositStatus"];
    var reserveError = TempData["ReserveError"] as string;
    var canonical = (string?)ViewData["Canonical"]
        ?? $"{Context.Request.Scheme}://{Context.Request.Host}/pub/{slug}/{Model.Id}";
}

<div class="breadcrumbs">
    <a href="/">GoatLab</a>
    <span class="sep">›</span>
    <a href="/breeds">Browse breeders</a>
    <span class="sep">›</span>
    <a href="/pub/@slug">@Model.FarmName</a>
    <span class="sep">›</span>
    <span>@Model.Name</span>
</div>

@if (depositStatus == "success")
{
    <div class="alert alert-success">
        <strong>Deposit received.</strong> @Model.FarmName has been notified and will reach out to finalize pickup.
    </div>
}
else if (depositStatus == "cancel")
{
    <div class="alert alert-info">Reservation was cancelled — no payment was taken.</div>
}
@if (!string.IsNullOrEmpty(reserveError))
{
    <div class="alert alert-error">@reserveError</div>
}

<div class="goat-header">
    <div>
        <span class="eyebrow">For sale</span>
        <h1>@Model.Name</h1>
        <p class="goat-meta">
            @(Model.Breed ?? "Unknown breed")
            @if (Model.DateOfBirth.HasValue)
            {
                <span> · @PublicFarmPagesController.AgeString(Model.DateOfBirth.Value)</span>
            }
            <span> · @Model.Gender</span>
            @if (!string.IsNullOrEmpty(Model.EarTag))
            {
                <span> · #@Model.EarTag</span>
            }
        </p>
    </div>
    @if (Model.AskingPriceCents.HasValue)
    {
        <div class="goat-price">
            <span class="eyebrow">Asking</span>
            <div class="price-amount">$@((Model.AskingPriceCents.Value / 100m).ToString("N0"))</div>
        </div>
    }
    <button id="fav-toggle" type="button" class="fav-btn"
            data-id="@Model.Id"
            data-slug="@slug"
            data-name="@Model.Name"
            data-breed="@(Model.Breed ?? "")"
            data-gender="@Model.Gender"
            data-dob="@(Model.DateOfBirth?.ToString("yyyy-MM-dd") ?? "")"
            data-price="@(Model.AskingPriceCents?.ToString() ?? "")"
            data-photo="@(Model.Photos.FirstOrDefault(p => p.IsPrimary)?.Url ?? Model.Photos.FirstOrDefault()?.Url ?? "")"
            data-farm="@Model.FarmName"
            aria-label="Save to favorites">
        <span class="fav-heart" aria-hidden="true">♡</span>
        <span class="fav-label">Save</span>
    </button>
</div>

@if (Model.Photos.Count > 0)
{
    <div class="goat-photos">
        @foreach (var p in Model.Photos)
        {
            <a href="@p.Url" target="_blank" class="goat-photo">
                <img src="@p.Url" alt="@(p.Caption ?? Model.Name)" loading="lazy" />
            </a>
        }
    </div>
}

<div class="goat-grid">
    <div class="goat-main">
        @if (!string.IsNullOrWhiteSpace(Model.Bio))
        {
            <section class="card">
                <h2>About @Model.Name</h2>
                <p class="prewrap">@Model.Bio</p>
            </section>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SaleNotes))
        {
            <section class="card">
                <h2>Sale notes</h2>
                <p class="prewrap">@Model.SaleNotes</p>
            </section>
        }
        @if (Model.Pedigree?.Sire is not null || Model.Pedigree?.Dam is not null)
        {
            <section class="card">
                <div class="d-flex" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;">
                    <h2 style="margin:0;">Pedigree</h2>
                    <a href="/lineage/@Model.Id" style="font-size:0.88rem;font-weight:600;">View full lineage →</a>
                </div>
                <div class="pedigree-grid">
                    <div class="pedigree-cell"><strong>@Model.Pedigree!.Name</strong></div>
                    <div>
                        <div class="pedigree-cell @(Model.Pedigree.Sire is null ? "pedigree-empty" : "")">
                            <span class="pedigree-label">Sire</span>
                            @(Model.Pedigree.Sire?.Name ?? "Unknown")
                        </div>
                        <div class="pedigree-cell @(Model.Pedigree.Dam is null ? "pedigree-empty" : "")" style="margin-top:8px;">
                            <span class="pedigree-label">Dam</span>
                            @(Model.Pedigree.Dam?.Name ?? "Unknown")
                        </div>
                    </div>
                    <div>
                        <div class="pedigree-cell @(Model.Pedigree.Sire?.Sire is null ? "pedigree-empty" : "")">
                            @(Model.Pedigree.Sire?.Sire?.Name ?? "—")
                        </div>
                        <div class="pedigree-cell @(Model.Pedigree.Sire?.Dam is null ? "pedigree-empty" : "")" style="margin-top:8px;">
                            @(Model.Pedigree.Sire?.Dam?.Name ?? "—")
                        </div>
                        <div class="pedigree-cell @(Model.Pedigree.Dam?.Sire is null ? "pedigree-empty" : "")" style="margin-top:8px;">
                            @(Model.Pedigree.Dam?.Sire?.Name ?? "—")
                        </div>
                        <div class="pedigree-cell @(Model.Pedigree.Dam?.Dam is null ? "pedigree-empty" : "")" style="margin-top:8px;">
                            @(Model.Pedigree.Dam?.Dam?.Name ?? "—")
                        </div>
                    </div>
                </div>
            </section>
        }
    </div>

    <aside class="goat-side">
        <section class="card">
            <h2>Seller</h2>
            <p class="seller-name">@Model.FarmName</p>
            @if (!string.IsNullOrEmpty(Model.FarmLocation))
            {
                <p class="seller-meta">📍 @Model.FarmLocation</p>
            }
            @if (!string.IsNullOrEmpty(Model.FarmContactEmail))
            {
                <a class="cta-button block-button"
                   href="mailto:@Model.FarmContactEmail?subject=Inquiry about @Model.Name">
                    Contact seller
                </a>
            }
            @if (Model.DepositCents is int deposit && deposit > 0)
            {
                <button type="button" class="block-button success-button" onclick="document.getElementById('reserve-dialog').showModal()">
                    Reserve with $@((deposit / 100m).ToString("N0")) deposit
                </button>
                <p class="reserve-note">Secure payment via Stripe · applied to purchase price</p>
            }
            <button type="button" class="block-button message-button" onclick="document.getElementById('message-dialog').showModal()">
                💬 Message @Model.FarmName
            </button>
            <p class="reserve-note">Ask about pickup, paperwork, anything — replies go straight to your inbox.</p>
            <button type="button" id="save-listing-btn" class="block-button save-button" data-goat-id="@Model.Id"
                    onclick="window.toggleSaveListing(this)">
                ⭐ Save to my list
            </button>
            <p class="reserve-note">Sign in by email — no password — to keep your saved goats across devices.</p>
        </section>

        @if (!string.IsNullOrEmpty(Model.Registry) || !string.IsNullOrEmpty(Model.RegistrationNumber))
        {
            <section class="card">
                <h2>Registration</h2>
                @if (!string.IsNullOrEmpty(Model.Registry))
                {
                    <p><strong>Registry:</strong> @Model.Registry</p>
                }
                @if (!string.IsNullOrEmpty(Model.RegistrationNumber))
                {
                    <p><strong>Reg #:</strong> @Model.RegistrationNumber</p>
                }
                @if (!string.IsNullOrEmpty(Model.BreederName))
                {
                    <p><strong>Breeder:</strong> @Model.BreederName</p>
                }
            </section>
        }

        <section class="card share-card">
            <h3 style="margin:0 0 8px 0;font-size:1rem;">Share this listing</h3>
            <div class="share-buttons">
                <a class="share-btn share-fb" target="_blank" rel="noopener"
                   href="@($"https://www.facebook.com/sharer/sharer.php?u={Uri.EscapeDataString(canonical)}")"
                   aria-label="Share on Facebook">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.13 8.44 9.93V14.9H7.9v-2.84h2.54v-2.16c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.83h2.78l-.45 2.84h-2.33V22c4.78-.8 8.44-4.93 8.44-9.94z"/></svg>
                    <span>Facebook</span>
                </a>
                <a class="share-btn share-x" target="_blank" rel="noopener"
                   href="@($"https://twitter.com/intent/tweet?url={Uri.EscapeDataString(canonical)}&text={Uri.EscapeDataString($"{Model.Name} — {Model.Breed} {Model.Gender} for sale on GoatLab")}")"
                   aria-label="Share on X (Twitter)">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M18.244 2H21l-6.5 7.43L22.5 22h-6.94l-4.84-6.34L4.97 22H2l7-7.99L1.5 2h7.06l4.36 5.78L18.24 2zm-2.43 18h1.94L7.27 4H5.2l10.6 16z"/></svg>
                    <span>X / Twitter</span>
                </a>
                <button type="button" class="share-btn share-copy"
                        data-copy="@canonical"
                        onclick="(function(b){navigator.clipboard.writeText(b.dataset.copy).then(function(){var t=b.querySelector('.share-copy-label');var o=t.textContent;t.textContent='Copied!';setTimeout(function(){t.textContent=o;},1500);});})(this)"
                        aria-label="Copy link">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
                    <span class="share-copy-label">Copy link</span>
                </button>
            </div>
        </section>

        <section class="card transfer-card">
            <h3 style="margin: 0 0 6px 0;">🐐 Already on GoatLab?</h3>
            <p style="margin: 0; font-size: 0.9rem;">
                If you buy @Model.Name, ask @Model.FarmName to transfer the record to your herd —
                full pedigree, medical history, weights, and photos move over instantly.
            </p>
            <a href="/register" style="display:inline-block;margin-top:8px;font-weight:600;">Start a free farm →</a>
        </section>
    </aside>
</div>

@* Message seller dialog (always available — independent of deposit setup) *@
<dialog id="message-dialog" class="reserve-dialog">
    <form id="message-form" class="reserve-form">
        <h2 style="margin-top:0;">Message @Model.FarmName</h2>
        <p class="reserve-summary">
            About <strong>@Model.Name</strong>. The seller gets your email and replies inside GoatLab — replies arrive in your inbox.
        </p>
        <label>
            <span>Your name *</span>
            <input type="text" name="BuyerName" required autocomplete="name" />
        </label>
        <label>
            <span>Your email *</span>
            <input type="email" name="BuyerEmail" required autocomplete="email" />
        </label>
        <label>
            <span>Phone (optional)</span>
            <input type="tel" name="BuyerPhone" autocomplete="tel" />
        </label>
        <label>
            <span>Your message *</span>
            <textarea name="Message" rows="5" required minlength="5" maxlength="4000"
                      placeholder="Hi! I'm interested in @Model.Name. Could you tell me about pickup options, registration paperwork, and any health testing?"></textarea>
        </label>
        <div id="message-status" class="alert" style="display:none;"></div>
        <div class="reserve-actions">
            <button type="button" onclick="document.getElementById('message-dialog').close()">Cancel</button>
            <button type="submit" class="cta-button">Send message</button>
        </div>
    </form>
</dialog>

<script>
    (function () {
        var form = document.getElementById('message-form');
        if (!form) return;
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            var status = document.getElementById('message-status');
            var btn = form.querySelector('button[type="submit"]');
            status.style.display = 'none';
            btn.disabled = true; btn.textContent = 'Sending…';
            var data = {
                BuyerName: form.BuyerName.value.trim(),
                BuyerEmail: form.BuyerEmail.value.trim(),
                BuyerPhone: form.BuyerPhone.value.trim() || null,
                Message: form.Message.value.trim()
            };
            try {
                var headers = { 'Content-Type': 'application/json' };
                if (window.goatlabRecaptcha) {
                    var token = await window.goatlabRecaptcha.execute('buyer_inquiry');
                    if (token) headers['X-Recaptcha-Token'] = token;
                }
                var resp = await fetch(@Json.Serialize($"/api/public/farms/{slug}/goats/{Model.Id}/inquire"), {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify(data)
                });
                if (resp.ok) {
                    status.style.display = '';
                    status.className = 'alert alert-success';
                    status.textContent = 'Sent! The seller will reply by email.';
                    form.reset();
                    setTimeout(function () { document.getElementById('message-dialog').close(); }, 2000);
                } else {
                    var body = await resp.json().catch(function () { return null; });
                    status.style.display = '';
                    status.className = 'alert alert-error';
                    status.textContent = (body && body.error) || 'Could not send. Please try again.';
                }
            } catch (err) {
                status.style.display = '';
                status.className = 'alert alert-error';
                status.textContent = 'Network error — please try again.';
            } finally {
                btn.disabled = false; btn.textContent = 'Send message';
            }
        });
    })();
</script>

@if (Model.DepositCents is int dep && dep > 0)
{
    <dialog id="reserve-dialog" class="reserve-dialog">
        <form method="post" action="/pub/@slug/@Model.Id/reserve-form" class="reserve-form" data-recaptcha-action="reserve">
            @Html.AntiForgeryToken()
            <h2 style="margin-top:0;">Reserve @Model.Name</h2>
            <p class="reserve-summary">
                $@((dep / 100m).ToString("N0")) deposit · Stripe payment · refundable per @Model.FarmName's policy.
                On success you'll go on @Model.FarmName's waitlist with the deposit recorded.
            </p>
            <label>
                <span>Your email *</span>
                <input type="email" name="BuyerEmail" required autocomplete="email" />
            </label>
            <label>
                <span>Your name *</span>
                <input type="text" name="BuyerName" required autocomplete="name" />
            </label>
            <label>
                <span>Phone (optional)</span>
                <input type="tel" name="BuyerPhone" autocomplete="tel" />
            </label>
            <label>
                <span>Notes for the seller (optional)</span>
                <textarea name="Notes" rows="3" placeholder="Pickup timing, registration paperwork, anything else..."></textarea>
            </label>
            <div class="reserve-actions">
                <button type="button" onclick="document.getElementById('reserve-dialog').close()">Cancel</button>
                <button type="submit" class="cta-button">Continue to Stripe</button>
            </div>
        </form>
    </dialog>
}

<style>
    .breadcrumbs a { color: #6b7a70; }

    .alert { padding: 12px 16px; border-radius: 8px; margin-bottom: 16px; }
    .alert-success { background: #e8f5e9; color: #1b5e20; border: 1px solid #a5d6a7; }
    .alert-info    { background: #e3f2fd; color: #0d47a1; border: 1px solid #90caf9; }
    .alert-error   { background: #ffebee; color: #c62828; border: 1px solid #ef9a9a; }

    .goat-header { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; margin-bottom: 16px; }
    .goat-header h1 { margin: 6px 0 4px 0; }
    .goat-meta { color: #6b7a70; margin: 0; }
    .goat-price { text-align: right; }
    .goat-price .price-amount { font-size: 2rem; font-weight: 700; color: #2e7d32; line-height: 1.1; }

    .goat-photos { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; margin: 16px 0 24px 0; }
    .goat-photo img { width: 100%; height: 220px; object-fit: cover; border-radius: 8px; display: block; }

    .goat-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; }
    @@media (max-width: 800px) { .goat-grid { grid-template-columns: 1fr; } }

    .card { background: #fff; border: 1px solid #e0e0e0; border-radius: 10px; padding: 18px; margin-bottom: 16px; }
    .card h2 { margin: 0 0 12px 0; font-size: 1.15rem; }
    .card p { margin: 4px 0; }
    .prewrap { white-space: pre-wrap; }
    .seller-name { font-weight: 700; font-size: 1.05rem; margin: 0; }
    .seller-meta { font-size: 0.9rem; color: #6b7a70; margin-top: 4px; }
    .block-button { display: block; width: 100%; text-align: center; margin-top: 12px; padding: 10px 14px; border-radius: 8px; font-weight: 600; cursor: pointer; border: none; font-size: 1rem; }
    .success-button { background: #2e7d32; color: #fff; }
    .success-button:hover { background: #1b5e20; }
    .message-button { background: #fff; color: #2e7d32; border: 1.5px solid #2e7d32; margin-top: 8px; }
    .message-button:hover { background: #e8f5e9; }
    .save-button { background: #fff; color: #4a5a51; border: 1.5px solid #ccc; margin-top: 8px; }
    .save-button:hover { background: #f5f5f5; border-color: #999; }
    .save-button.saved { background: #fff8e1; color: #f57f17; border-color: #ffd54f; }
    .save-button.saved:hover { background: #fff3c4; }
    .reserve-note { font-size: 0.78rem; color: #6b7a70; text-align: center; margin-top: 6px; }

    .pedigree-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }
    .pedigree-cell { padding: 10px 12px; background: rgba(46,125,50,0.05); border-radius: 6px; border: 1px solid rgba(46,125,50,0.15); font-size: 0.85rem; }
    .pedigree-empty { background: rgba(0,0,0,0.02); border-style: dashed; color: #999; }
    .pedigree-label { display: block; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 1px; color: #6b7a70; }

    .transfer-card { background: linear-gradient(135deg,#f1f8e9 0%,#e8f5e9 100%); border-color: #c5e1a5; }
    .share-card { background: #fff; }
    .share-buttons { display: flex; flex-wrap: wrap; gap: 8px; }
    .share-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 12px;
        background: #f5f5f5;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        font-size: 0.85rem; font-weight: 500;
        color: #1a2421;
        text-decoration: none;
        cursor: pointer; font-family: inherit;
        transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    .share-btn:hover { background: #fff; border-color: #2e7d32; color: #1b5e20; text-decoration: none; }
    .share-btn svg { flex-shrink: 0; }
    .share-fb:hover { color: #1877f2; border-color: #1877f2; }
    .share-x:hover { color: #000; border-color: #000; }

    .reserve-dialog { border: 0; border-radius: 12px; padding: 0; max-width: 480px; width: 100%; box-shadow: 0 20px 60px rgba(0,0,0,0.2); }
    .reserve-dialog::backdrop { background: rgba(0,0,0,0.5); }
    .reserve-form { padding: 24px; }
    .reserve-form label { display: block; margin-bottom: 12px; font-size: 0.9rem; }
    .reserve-form label span { display: block; margin-bottom: 4px; color: #4a5a51; font-weight: 500; }
    .reserve-form input, .reserve-form textarea { width: 100%; padding: 10px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 1rem; font-family: inherit; }
    .reserve-form input:focus, .reserve-form textarea:focus { outline: none; border-color: #2e7d32; box-shadow: 0 0 0 2px rgba(46,125,50,0.2); }
    .reserve-summary { background: #f5f5f5; padding: 10px 12px; border-radius: 6px; font-size: 0.88rem; color: #4a5a51; margin-bottom: 16px; }
    .reserve-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 8px; }
    .reserve-actions button { padding: 10px 18px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer; font-size: 0.95rem; }
    .reserve-actions button[type="button"] { background: #f0f0f0; color: #1a2421; }
    .reserve-actions button.cta-button { background: #2e7d32; color: #fff; }

    .fav-btn {
        margin-left: 12px;
        background: #fff;
        border: 1.5px solid #e0e0e0;
        border-radius: 8px;
        padding: 8px 14px;
        font-size: 14px;
        font-weight: 600;
        color: #1a2421;
        cursor: pointer;
        display: inline-flex; align-items: center; gap: 6px;
        transition: background 0.12s, border-color 0.12s, color 0.12s;
    }
    .fav-btn:hover { border-color: #c2185b; }
    .fav-btn .fav-heart { font-size: 18px; line-height: 1; color: #c2185b; }
    .fav-btn.is-saved { background: #fce4ec; border-color: #c2185b; color: #ad1457; }
    .fav-btn.is-saved .fav-heart::before { content: '♥'; }
    .fav-btn.is-saved .fav-heart { font-size: 0; }
    .fav-btn.is-saved .fav-heart::before { font-size: 18px; }
</style>

<script>
    (function () {
        var btn = document.getElementById('fav-toggle');
        if (!btn) return;
        var KEY = 'goatlab.favorites';
        var data = btn.dataset;

        function read() {
            try { return JSON.parse(localStorage.getItem(KEY) || '[]'); }
            catch { return []; }
        }
        function write(list) {
            try { localStorage.setItem(KEY, JSON.stringify(list)); } catch { }
        }
        function isSaved() {
            return read().some(function (f) { return f.id == data.id && f.slug === data.slug; });
        }
        function refresh() {
            if (isSaved()) {
                btn.classList.add('is-saved');
                btn.querySelector('.fav-label').textContent = 'Saved';
            } else {
                btn.classList.remove('is-saved');
                btn.querySelector('.fav-label').textContent = 'Save';
            }
        }
        btn.addEventListener('click', function () {
            var list = read().filter(function (f) { return !(f.id == data.id && f.slug === data.slug); });
            if (!isSaved()) {
                // limit to 12 to keep /compare manageable
                if (list.length >= 12) list.shift();
                list.push({
                    id: parseInt(data.id, 10),
                    slug: data.slug,
                    name: data.name,
                    breed: data.breed,
                    gender: data.gender,
                    dob: data.dob,
                    priceCents: data.price ? parseInt(data.price, 10) : null,
                    photoUrl: data.photo,
                    farm: data.farm,
                    savedAt: Date.now()
                });
            }
            write(list);
            refresh();
        });
        refresh();
    })();
</script>
