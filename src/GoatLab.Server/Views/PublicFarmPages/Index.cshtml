@using GoatLab.Shared.DTOs
@using GoatLab.Server.Controllers
@model List<PublicGoatListItemDto>
@{
    var slug = (string?)ViewData["FarmSlug"] ?? "";
    var name = (string?)ViewData["FarmName"] ?? slug;
    var location = (string?)ViewData["FarmLocation"];
    var contactEmail = (string?)ViewData["ContactEmail"];
    var accentColor = (string?)ViewData["AccentColor"];
    var welcomeMessage = (string?)ViewData["WelcomeMessage"];
    var listingCount = Model.Count;
}

@if (!string.IsNullOrEmpty(accentColor))
{
    @* Inline brand override — applied to the breadcrumb arrow, h1, and CTA.
       The hex was server-validated against /^#[0-9a-fA-F]{6}$/ before save
       so it's safe to inline here. *@
    <style>
        .farm-header h1 { color: @accentColor !important; }
        .farm-header .cta-button { background-color: @accentColor !important; }
        .farm-header .eyebrow { color: @accentColor !important; }
        .farm-welcome { border-left: 4px solid @accentColor; }
    </style>
}

<div class="breadcrumbs">
    <a href="/">GoatLab</a>
    <span class="sep">›</span>
    <a href="/breeds">Browse breeds</a>
    <span class="sep">›</span>
    <span>@name</span>
</div>

<div class="farm-header">
    <div>
        <span class="eyebrow">Public farm page</span>
        <h1>@name</h1>
        @if (!string.IsNullOrEmpty(location))
        {
            <p class="lede">📍 @location · @listingCount @(listingCount == 1 ? "goat" : "goats") for sale</p>
        }
        else
        {
            <p class="lede">@listingCount @(listingCount == 1 ? "goat" : "goats") for sale</p>
        }
    </div>
    @if (!string.IsNullOrEmpty(contactEmail))
    {
        <a class="cta-button" href="mailto:@contactEmail?subject=Inquiry%20from%20GoatLab%20listing">Contact seller</a>
    }
</div>

@if (!string.IsNullOrEmpty(welcomeMessage))
{
    <section class="farm-welcome">
        @* HtmlEncoded by Razor's @ — no rich HTML allowed in welcome messages. *@
        @welcomeMessage
    </section>
    <style>
        .farm-welcome {
            background: #f8f9f7;
            padding: 16px 20px;
            border-radius: 0 8px 8px 0;
            margin: 0 0 24px 0;
            border-left: 4px solid #2e7d32;
            white-space: pre-wrap;
            color: #1a2421;
            line-height: 1.55;
        }
    </style>
}

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="icon">🐐</div>
        <p>No goats currently listed for sale.</p>
        <p style="font-size:0.9rem;">Check back soon, or <a href="/breeds">browse other breeders</a>.</p>
    </div>
}
else
{
    <div class="goats-grid">
        @foreach (var g in Model)
        {
            <a class="goat-card" href="/pub/@slug/@g.Id">
                <div class="goat-card-photo @(string.IsNullOrEmpty(g.PrimaryPhotoUrl) ? "empty" : "")">
                    @if (!string.IsNullOrEmpty(g.PrimaryPhotoUrl))
                    {
                        <img src="@g.PrimaryPhotoUrl" alt="@g.Name" loading="lazy" />
                    }
                    else
                    {
                        <span>🐐</span>
                    }
                </div>
                <div class="goat-card-body">
                    <div class="goat-card-name">@g.Name</div>
                    <div class="goat-card-meta">
                        @(g.Breed ?? "Unknown breed") · @g.Gender
                        @if (g.DateOfBirth.HasValue)
                        {
                            <span> · @PublicFarmPagesController.AgeString(g.DateOfBirth.Value)</span>
                        }
                    </div>
                    @if (g.AskingPriceCents.HasValue)
                    {
                        <div class="goat-card-price">$@((g.AskingPriceCents.Value / 100m).ToString("N0"))</div>
                    }
                </div>
            </a>
        }
    </div>
}

<div class="farm-follow">
    <div class="farm-follow-icon">📬</div>
    <div class="farm-follow-body">
        <h3 style="margin:0 0 4px 0;">Follow @name</h3>
        <p style="margin:0 0 12px 0;color:#4a5a51;font-size:0.95rem;">
            Get one email when @name lists a new goat for sale. No marketing, no daily digests. Unsubscribe anytime.
        </p>
        <form id="follow-form" class="farm-follow-form">
            <input type="email" name="email" placeholder="you@example.com" required autocomplete="email"
                   aria-label="Your email address" />
            <button type="submit">Follow</button>
        </form>
        <div id="follow-status" class="farm-follow-status" role="status"></div>
    </div>
</div>

<div class="farm-footer-cta">
    <p>
        Are you a breeder? <a href="/register">Start your own free GoatLab farm</a> and list your goats here.
    </p>
</div>

<script>
    (function () {
        var form = document.getElementById('follow-form');
        var status = document.getElementById('follow-status');
        if (!form || !status) return;
        form.addEventListener('submit', async function (e) {
            e.preventDefault();
            var input = form.querySelector('input[name="email"]');
            var btn = form.querySelector('button');
            if (!input || !btn) return;
            var email = (input.value || '').trim();
            if (!email) return;
            btn.disabled = true; btn.textContent = '…';
            status.textContent = '';
            status.className = 'farm-follow-status';
            try {
                var headers = { 'Content-Type': 'application/json' };
                if (window.goatlabRecaptcha) {
                    var token = await window.goatlabRecaptcha.execute('follow_farm');
                    if (token) headers['X-Recaptcha-Token'] = token;
                }
                var resp = await fetch(@Json.Serialize($"/api/public/farms/{slug}/follow"), {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify({ email: email })
                });
                var data = await resp.json().catch(function () { return null; });
                if (resp.ok && data && data.ok) {
                    status.textContent = data.message || ('You’re now following @name.');
                    status.className = 'farm-follow-status farm-follow-success';
                    input.value = '';
                } else {
                    status.textContent = (data && data.message) || ('Couldn’t subscribe. Try again in a moment.');
                    status.className = 'farm-follow-status farm-follow-error';
                }
            } catch (err) {
                status.textContent = 'Network error — please try again.';
                status.className = 'farm-follow-status farm-follow-error';
            } finally {
                btn.disabled = false; btn.textContent = 'Follow';
            }
        });
    })();
</script>

<style>
    .farm-header { display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 28px; }
    .farm-header h1 { margin: 6px 0 6px 0; }
    .farm-header .lede { margin: 0; }

    .goats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 16px;
    }
    .goat-card {
        display: block;
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .goat-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.08); text-decoration: none; }
    .goat-card-photo { aspect-ratio: 4 / 3; background: #f5f5f5; }
    .goat-card-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .goat-card-photo.empty { display: flex; align-items: center; justify-content: center; font-size: 3rem; color: #bbb; }
    .goat-card-body { padding: 12px 14px; }
    .goat-card-name { font-weight: 700; font-size: 1.1rem; }
    .goat-card-meta { font-size: 0.88rem; color: #6b7a70; margin-top: 2px; }
    .goat-card-price { color: #2e7d32; font-weight: 700; font-size: 1.05rem; margin-top: 6px; }

    .farm-footer-cta {
        margin-top: 40px;
        padding: 20px;
        background: #f1f8e9;
        border-radius: 10px;
        text-align: center;
        color: #1b5e20;
        font-size: 0.95rem;
    }

    .farm-follow {
        display: flex;
        gap: 16px;
        margin-top: 32px;
        padding: 18px 20px;
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        align-items: flex-start;
    }
    .farm-follow-icon { font-size: 32px; line-height: 1; }
    .farm-follow-body { flex: 1; min-width: 0; }
    .farm-follow-form { display: flex; gap: 8px; flex-wrap: wrap; }
    .farm-follow-form input {
        flex: 1; min-width: 200px;
        padding: 10px 12px;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 14px;
        font-family: inherit;
    }
    .farm-follow-form input:focus { outline: none; border-color: #2e7d32; box-shadow: 0 0 0 2px rgba(46,125,50,0.15); }
    .farm-follow-form button {
        padding: 10px 18px;
        background: #2e7d32;
        color: #fff;
        border: 0;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
    }
    .farm-follow-form button:hover { background: #1b5e20; }
    .farm-follow-form button:disabled { opacity: 0.6; cursor: not-allowed; }
    .farm-follow-status { font-size: 0.88rem; margin-top: 8px; min-height: 1.2em; }
    .farm-follow-success { color: #1b5e20; }
    .farm-follow-error { color: #c62828; }
</style>
