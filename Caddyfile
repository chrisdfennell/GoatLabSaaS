# Caddy v2 reverse proxy + auto-TLS via Let's Encrypt for goatlab.app.
#
# Caddy obtains + renews certs automatically using ACME HTTP-01 challenge,
# which requires:
#   1. DNS A record for goatlab.app and CNAME www → goatlab.app
#   2. Ports 80 and 443 reachable from the public internet
#   3. An email address below for LE expiry notifications
#
# Update the email if a different address should receive cert expiry notices.
{
    email noreply@goatlab.app
}

goatlab.app, www.goatlab.app {
    # All requests proxied to the goatlab compose service on its internal port.
    reverse_proxy goatlab:8080

    encode gzip zstd

    header {
        # HSTS — opt into preload list once we're confident of stability.
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Defensive defaults; tighten further with a real CSP once content is finalized.
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Hide the Caddy server header.
        -Server
    }

    # Year-long immutable cache for *content-hashed* assets only —
    # Blazor's build emits hashed filenames under /_framework, and our /lib
    # third-party files are versioned. Caching these forever is safe.
    @immutable {
        path /_framework/* /lib/* /images/*
    }
    header @immutable Cache-Control "public, max-age=31536000, immutable"

    # /js/* and /css/* are hand-written and NOT content-hashed (e.g.
    # /js/recaptcha-interop.js). A year-long immutable cache here means
    # critical JS fixes never reach existing users until they manually
    # clear cache. Short cache + must-revalidate forces the browser to
    # re-check ETags, so a redeploy propagates within minutes.
    @short {
        path /css/* /js/*
    }
    header @short Cache-Control "public, max-age=300, must-revalidate"

    # Service worker should never be cached.
    @sw {
        path /service-worker.js /service-worker.published.js
    }
    header @sw Cache-Control "no-cache, no-store, must-revalidate"

    log {
        output stdout
        format console
    }
}
